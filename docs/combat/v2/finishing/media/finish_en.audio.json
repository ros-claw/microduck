{
  "cues": [
    {
      "start_s": 1.5499999999999998,
      "end_s": 3.8472916666666666,
      "text": "Rook and Shade, against Bolt and Anchor.",
      "zh_CN": "Rook and Shade, against Bolt and Anchor.",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "680039806129d1f3e99fa5dcb6c7ee6c252104c5fbce893ddc708c556b20c9a7",
      "duration_s": 2.2972916666666667
    },
    {
      "start_s": 5.050000000000001,
      "end_s": 8.372958333333333,
      "text": "Blue presses forward. Red has to find the angle.",
      "zh_CN": "Blue presses forward. Red has to find the angle.",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "c80452b6f6d3fdd050d42420493da73080a3733d7dcd8881abf442d95ff787c4",
      "duration_s": 3.3229583333333332
    },
    {
      "start_s": 12.35,
      "end_s": 15.568145833333332,
      "text": "Shade pulls away. Rook comes across to cover!",
      "zh_CN": "Shade pulls away. Rook comes across to cover!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "54ecbe7e8d38e4ddde4ff5c52f2ed13e51756c3e5401076b2dc6424b97b61533",
      "duration_s": 3.2181458333333333
    },
    {
      "start_s": 16.549999999999997,
      "end_s": 20.758604166666665,
      "text": "Anchor is chasing Shade. Look behind him: here comes Rook!",
      "zh_CN": "Anchor is chasing Shade. Look behind him: here comes Rook!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "6a3e1f5339388a3d53cc009792574e9d2c95637b76a6203cc5e5f750687738db",
      "duration_s": 4.2086041666666665
    },
    {
      "start_s": 22.209999999999997,
      "end_s": 25.564499999999995,
      "text": "Rook keeps coming from the side. Blue has to turn.",
      "zh_CN": "Rook keeps coming from the side. Blue has to turn.",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "4ba778fd6a8de3c9eabb46eb2cc6790730f169f67319bf2759f6376a380466e8",
      "duration_s": 3.3545
    },
    {
      "start_s": 29.609999999999996,
      "end_s": 33.243874999999996,
      "text": "Anchor loses the edge. Watch Rook keep his feet inside.",
      "zh_CN": "Anchor loses the edge. Watch Rook keep his feet inside.",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "5d9e2126496e7748c64829f173ae7219588594b534273d4d1b2ecdc2c55d3bba",
      "duration_s": 3.633875
    },
    {
      "start_s": 35.60999999999999,
      "end_s": 37.90416666666666,
      "text": "Bolt is up. Rook changes targets!",
      "zh_CN": "Bolt is up. Rook changes targets!",
      "voice": "en-GB-RyanNeural",
      "rate": "+38%",
      "voice_asset_sha256": "125b41c95e518915a49c4701efc50e14fc20b2851a3100b1bcda7e3a17537154",
      "duration_s": 2.2941666666666665
    },
    {
      "start_s": 38.24999999999999,
      "end_s": 42.60266666666666,
      "text": "From the open side. Rook makes contact, then stays inside.",
      "zh_CN": "From the open side. Rook makes contact, then stays inside.",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "9602a5643021e28655133405bf60b40de83a2aaf44410a4d4301edc4d9f352fc",
      "duration_s": 4.352666666666667
    },
    {
      "start_s": 45.54999999999999,
      "end_s": 46.64695833333332,
      "text": "Red team wins!",
      "zh_CN": "Red team wins!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "ed682fe861f26dae97637075c1820d74767de5dd5d5329063f999e5f534c6a14",
      "duration_s": 1.0969583333333333
    }
  ],

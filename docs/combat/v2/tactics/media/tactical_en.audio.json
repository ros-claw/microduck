{
  "cues": [
    {
      "start_s": 0.15,
      "end_s": 4.101354166666667,
      "text": "Four robots. Two teams. One unforgiving edge.",
      "zh_CN": "Four robots. Two teams. One unforgiving edge.",
      "voice": "en-GB-RyanNeural",
      "rate": "+25%",
      "voice_asset_sha256": "2a28003c5b5f4bf4281f49ea8c1006541970f4f088ef8ba56a5ca9c6e4b4b66e",
      "duration_s": 3.9513541666666665
    },
    {
      "start_s": 4.5,
      "end_s": 8.972395833333334,
      "text": "Anchor commits. Shade steps aside, turns, and comes back in!",
      "zh_CN": "Anchor commits. Shade steps aside, turns, and comes back in!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "13ae3ec0b7e45ee04004df2fda6000b619bb2bfae06922089becce652320622c",
      "duration_s": 4.472395833333334
    },
    {
      "start_s": 20.5,
      "end_s": 25.598770833333333,
      "text": "Another charge. Another sidestep. Watch Shade turn into the opening!",
      "zh_CN": "Another charge. Another sidestep. Watch Shade turn into the opening!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "4f512e0511de1bfce02c5c26989add37b5d282af3aface1718805ca111a7ae88",
      "duration_s": 5.098770833333333
    },
    {
      "start_s": 26.549999999999997,
      "end_s": 31.679604166666664,
      "text": "New bout. Shade draws Anchor forward. Rook cuts around the side.",
      "zh_CN": "New bout. Shade draws Anchor forward. Rook cuts around the side.",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "bfd131b052071aa1f1f8d82f69633e7b3f25bd4b8b1c751dc08bcab6655ab2da",
      "duration_s": 5.129604166666667
    },
    {
      "start_s": 32.7,
      "end_s": 36.989958333333334,
      "text": "Blue switches targets! Bolt gets around Shade's exposed side.",
      "zh_CN": "Blue switches targets! Bolt gets around Shade's exposed side.",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "9d2b60eef644a6cefb0fa3ba6089ff1d4333dc9fba100a354c0088c95c0aa503",
      "duration_s": 4.289958333333334
    },
    {
      "start_s": 42.26,
      "end_s": 45.81497916666667,
      "text": "Rook is running out of room. Shade moves across to cover!",
      "zh_CN": "Rook is running out of room. Shade moves across to cover!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "ee7bbdbeae0f3acb0dcce4c6b3af9855bf98fa00901e3492585ee2b98428218b",
      "duration_s": 3.5549791666666666
    },
    {
      "start_s": 46.31999999999999,
      "end_s": 49.741895833333324,
      "text": "Contact at the edge! Anchor loses his footing!",
      "zh_CN": "Contact at the edge! Anchor loses his footing!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "1bad30230bc4ac3e342cfa1aaecbb4f682fce8846030e59306f716a58f0f0afa",
      "duration_s": 3.421895833333333
    },
    {
      "start_s": 53.239999999999995,
      "end_s": 57.08116666666666,
      "text": "And Shade follows him out! One robot lost on each team!",
      "zh_CN": "And Shade follows him out! One robot lost on each team!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "6326a3b4b751859c52ba107ce34bdca75dd59cbb48d752c12308d3d4804f6366",
      "duration_s": 3.8411666666666666
    },
    {
      "start_s": 58.88999999999999,
      "end_s": 60.15539583333333,
      "text": "Rook finds the side!",
      "zh_CN": "Rook finds the side!",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "204fbce13a027f0ac159eef7e05f270e01017e361d626d4bfc932883ca7ff167",
      "duration_s": 1.2653958333333333
    },
    {
      "start_s": 61.23,
      "end_s": 63.599374999999995,
      "text": "Time expires. A draw.",
      "zh_CN": "Time expires. A draw.",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "5342ea30f03a2c8ca17b3092bf6c27fd8702ef0ce8646f69977c2ccf574ebeb4",
      "duration_s": 2.369375
    }
  ],

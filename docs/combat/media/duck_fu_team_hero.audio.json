{
  "cues": [
    {
      "start_s": 0.15,
      "end_s": 4.757000000000001,
      "text": "Four Microducks. Two teams. One physics arena!",
      "zh_CN": "四只 Microduck，两支队伍，同一个物理擂台！",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "b36bcee18cdacf6ecca4b9db801a0eea21380aefb808690a932336d4dbea7fde",
      "duration_s": 4.607
    },
    {
      "start_s": 7.0,
      "end_s": 9.206020833333334,
      "text": "Rook! That bump lands!",
      "zh_CN": "张三，这一下撞到了！",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "3b15b4fab1f11f742d1164326ef4b04e3bafa091ecc7f07db1a60d3003773ae3",
      "duration_s": 2.2060208333333335
    },
    {
      "start_s": 11.14,
      "end_s": 12.314270833333333,
      "text": "Shade lands a bump!",
      "zh_CN": "老六也撞中了！",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "f8f1ac68ba5371c2dba18140fb860ba861c703805adb7e7cb6ecc28c39a85235",
      "duration_s": 1.1742708333333334
    },
    {
      "start_s": 14.0,
      "end_s": 18.36627083333333,
      "text": "Tactics pick the move. Learned motors control all fourteen joints.",
      "zh_CN": "战术决定动作，学习得到的运动策略控制十四个关节。",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "bc4cb55795ce922ac30a7581cf5d4428593efb86d23f3ce72d7a4ee8bbf43a52",
      "duration_s": 4.366270833333333
    },
    {
      "start_s": 23.1,
      "end_s": 25.047,
      "text": "Now watch the contact in slow motion.",
      "zh_CN": "慢下来，观察真正发生的接触。",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "56fe2ac654211f922383c02c0cded7bffb69ccd709528fa623a836aed53f6906",
      "duration_s": 1.947
    },
    {
      "start_s": 27.1,
      "end_s": 29.43691666666667,
      "text": "The robots have to regain stable foot support.",
      "zh_CN": "机器人必须重新获得稳定的足部支撑。",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "949ce8ff60796964d50290a3e6360387689907be41b7eadb21b6b18de6f829df",
      "duration_s": 2.3369166666666668
    },
    {
      "start_s": 31.2,
      "end_s": 35.179625,
      "text": "Back to full speed. This fight is being decided by physics!",
      "zh_CN": "回到正常速度，胜负由物理过程决定！",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "044bd3baf47b6647e9c98cae8e41df2f598da96f091174e0fc4736f9727d0e91",
      "duration_s": 3.979625
    },
    {
      "start_s": 40.1,
      "end_s": 41.196958333333335,
      "text": "Red team wins!",
      "zh_CN": "红队获胜！",
      "voice": "en-GB-RyanNeural",
      "rate": "+12%",
      "voice_asset_sha256": "ed682fe861f26dae97637075c1820d74767de5dd5d5329063f999e5f534c6a14",
      "duration_s": 1.0969583333333333
    }
  ],

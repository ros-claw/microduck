+"""Running roulade transfer to bounded, hard ground/self contacts.
+
+Built from the official roulade task; simulation-only PD deployment target.
+No root intervention is used after reset. Native collision geometry is retained.
+"""
+from copy import deepcopy
+from dataclasses import dataclass
+import mujoco
+import numpy as np
+from mjlab.terrains.terrain_generator import SubTerrainCfg, TerrainGeneratorCfg, TerrainOutput, TerrainGeometry
+from mjlab_microduck.robot.microduck_constants import MICRODUCK_STANDUP_PD_ROBOT_CFG
+from .microduck_parkour_env_cfg import parkour_robot_spec
+from .microduck_roulade_env_cfg import make_microduck_roulade_env_cfg, MicroduckRouladeRlCfg
+
+
+def hard_roll_spec():
+    spec=parkour_robot_spec()
+    for geom in spec.geoms:
+        if geom.contype:
+            geom.solref=[.002,1.]
+            geom.solimp=[.9,.95,.001,.5,2.]
+            geom.margin=0.
+    return spec
+
+
+@dataclass(kw_only=True)
+class HardFloorCfg(SubTerrainCfg):
+    def function(self,difficulty,spec,rng):
+        del difficulty,rng
+        ox,oy=self.size[0]/2,self.size[1]/2
+        geom=spec.body('terrain').add_geom(type=mujoco.mjtGeom.mjGEOM_BOX,
+            pos=[ox,oy,-.04],size=[ox,oy,.04],friction=[1,.005,.0001],
+            priority=1,solref=[.002,1.],solimp=[.9,.95,.001,.5,2.],margin=0.)
+        return TerrainOutput(origin=np.array([ox,oy,0.]),geometries=[TerrainGeometry(geom=geom,color=(.08,.10,.15,1))])
+
+
+def make_microduck_parkour_roll_env_cfg(play=False):
+    cfg=make_microduck_roulade_env_cfg(play=play)
+    cfg.scene.entities['robot']=deepcopy(MICRODUCK_STANDUP_PD_ROBOT_CFG)
+    cfg.scene.entities['robot'].spec_fn=hard_roll_spec
+    cfg.scene.entities['robot'].init_state.pos=(0.,0.,.12)
+    cfg.scene.entities['robot'].collisions=()
+    cfg.sim.mujoco.timestep=.001
+    cfg.decimation=20
+    cfg.episode_length_s=3.
+    cfg.scene.terrain.terrain_type='generator'
+    cfg.scene.terrain.terrain_generator=TerrainGeneratorCfg(size=(4.,4.),num_rows=1,num_cols=1,
+        sub_terrains={'hard_floor':HardFloorCfg()},border_width=0.,color_scheme='none')
+    cfg.events.pop('randomize_joint_friction',None)
+    cfg.events.pop('randomize_motor_gains',None)
+    spawn=cfg.events['set_roulade_state'].params
+    spawn.update(standing_prob=.8,midroll_prob=.2,standing_z_min=.12,standing_z_max=.125,
+                 forward_vel_range=(0.,.55),joint_noise_std=.025)
+    cfg.curriculum.pop('roulade_spawn_mix',None)
+    # Deployment supplies current joint velocity, unlike the gap policy.
+    cfg.observations['actor'].terms['joint_vel'].delay_min_lag=0
+    cfg.observations['actor'].terms['joint_vel'].delay_max_lag=0
+    for name in ('roulade_landing_composite','roulade_height_after_roll','roulade_landing_sharp','roulade_stand_tax'):
+        cfg.rewards[name].params['target_height']=.117
+    return cfg
+
+
+MicroduckParkourRollRlCfg=deepcopy(MicroduckRouladeRlCfg)
+MicroduckParkourRollRlCfg.experiment_name='microduck_parkour_roll'
+MicroduckParkourRollRlCfg.run_name='hard_contact_transfer'
+MicroduckParkourRollRlCfg.save_interval=100
+MicroduckParkourRollRlCfg.max_iterations=601

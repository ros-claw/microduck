+"""Initialize PPO's actor from an existing normalized ONNX; not a policy export.
+
+The resulting actor is checked numerically against ONNX before any training.
+Final trained policies must still use scripts/export.py to bake normalization.
+"""
+import argparse
+from pathlib import Path
+import numpy as np
+import onnx
+from onnx import numpy_helper
+import onnxruntime as ort
+import torch
+from torch import nn
+
+p=argparse.ArgumentParser();p.add_argument('--template',required=True);p.add_argument('--policy',required=True);p.add_argument('--output',required=True);a=p.parse_args()
+checkpoint=torch.load(a.template,map_location='cpu',weights_only=False)
+weights={x.name:torch.from_numpy(numpy_helper.to_array(x).copy()) for x in onnx.load(a.policy).graph.initializer}
+actor=checkpoint['actor_state_dict']
+for name in list(actor):
+    if name in weights:actor[name]=weights[name]
+divisors=[v for k,v in weights.items() if k.startswith('onnx::Div')]
+if len(divisors)!=1:raise ValueError('Unexpected normalization graph')
+actor['obs_normalizer._std']=divisors[0]-.01
+if (actor['obs_normalizer._std']<0).any():raise ValueError('Unexpected normalization epsilon')
+actor['obs_normalizer._var']=actor['obs_normalizer._std'].square()
+actor['obs_normalizer.count'].fill_(100000)
+actor['distribution.std_param'].fill_(.5)
+mlp=nn.Sequential(nn.Linear(61,512),nn.ELU(),nn.Linear(512,256),nn.ELU(),nn.Linear(256,128),nn.ELU(),nn.Linear(128,14))
+mlp.load_state_dict({k.removeprefix('mlp.'):v for k,v in actor.items() if k.startswith('mlp.')})
+obs=np.random.default_rng(7).normal(size=(128,61)).astype(np.float32)
+with torch.no_grad():actual=mlp((torch.from_numpy(obs)-actor['obs_normalizer._mean'])/(actor['obs_normalizer._std']+.01)).numpy()
+session=ort.InferenceSession(a.policy);expected=session.run(None,{session.get_inputs()[0].name:obs})[0] if session.get_inputs()[0].shape[0]!=1 else np.concatenate([session.run(None,{session.get_inputs()[0].name:x[None]})[0] for x in obs])
+np.testing.assert_allclose(actual,expected,rtol=2e-4,atol=2e-4)
+checkpoint['optimizer_state_dict']['state']={}
+checkpoint['iter']=0;checkpoint['infos']=None
+Path(a.output).parent.mkdir(parents=True,exist_ok=True);torch.save(checkpoint,a.output)
+print('seed parity max absolute error',float(np.abs(actual-expected).max()),'saved',a.output)

+"""Measure standing equilibrium before training the hard-contact roll task."""
+import json
+import numpy as np
+import onnxruntime as ort
+import torch
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab_microduck.tasks.microduck_parkour_roll_env_cfg import make_microduck_parkour_roll_env_cfg
+cfg=make_microduck_parkour_roll_env_cfg()
+cfg.scene.num_envs=4
+cfg.events['set_roulade_state'].params.update(standing_prob=1.,midroll_prob=0.,standing_z_min=.12,standing_z_max=.122,standing_tilt_max=.01,forward_vel_range=(0.,0.))
+cfg.observations['actor'].enable_corruption=False
+cfg.terminations.clear()
+env=ManagerBasedRlEnv(cfg=cfg,device='cuda:0')
+obs,_=env.reset()
+session=ort.InferenceSession('../microduck/policies/alpha_stand.onnx')
+for i in range(150):
+    x=obs['actor'].cpu().numpy().astype(np.float32)
+    actions=np.concatenate([session.run(None,{session.get_inputs()[0].name:row[None]})[0] for row in x])
+    obs,*_=env.step(torch.tensor(actions,device=env.device))
+r=env.scene['robot'];up=-r.data.projected_gravity_b[:,2];height=r.data.root_link_pos_w[:,2]
+result=dict(up=up.tolist(),height=height.tolist(),passed=bool(torch.all(up>.95)&torch.all(height>.10)),duration_s=3.)
+print('EQUILIBRIUM',json.dumps(result),flush=True)
+assert result['passed']
+env.close()

+import mujoco
+import numpy as np
+from mjlab_microduck.tasks.microduck_parkour_env_cfg import make_microduck_parkour_env_cfg, ParkourGapTerrainCfg, parkour_robot_spec
+
+
+def test_real_gap_and_no_support_plane():
+    spec=mujoco.MjSpec();spec.worldbody.add_body(name='terrain')
+    cfg=ParkourGapTerrainCfg(size=(3.,2.));cfg.function(0.,spec,np.random.default_rng(0))
+    m=spec.compile();d=mujoco.MjData(m);mujoco.mj_forward(m,d)
+    out=np.array([-1],dtype=np.int32)
+    assert mujoco.mj_ray(m,d,np.array([1.675,1.,1.]),np.array([0.,0.,-1.]),None,1,-1,out)==-1
+    assert mujoco.mj_ray(m,d,np.array([1.9,1.,1.]),np.array([0.,0.,-1.]),None,1,-1,out)>0
+
+
+def test_current_limit_and_observation_contract():
+    m=parkour_robot_spec().compile()
+    assert np.allclose(m.actuator_forcerange,[-.6405,.6405])
+    cfg=make_microduck_parkour_env_cfg()
+    assert cfg.decimation*cfg.sim.mujoco.timestep==.02
+    assert cfg.scene.entities['robot'].init_state.pos[2] == .12
+    assert 'base_lin_vel' not in cfg.observations['actor'].terms
+    assert list(cfg.observations['actor'].terms)==['base_ang_vel','projected_gravity','joint_pos','joint_vel','actions','command','head_command','body_command']
+    assert cfg.rewards['parkour_sideways'].weight>0
+    assert 'jump_stay_in_place' not in cfg.rewards

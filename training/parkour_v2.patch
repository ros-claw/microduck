+import mujoco
+import numpy as np
+from mjlab_microduck.tasks.microduck_parkour_roll_env_cfg import make_microduck_parkour_roll_env_cfg, hard_roll_spec, HardFloorCfg
+
+
+def test_contact_profile_and_current_limit():
+    model=hard_roll_spec().compile()
+    ids=model.geom_contype!=0
+    assert np.allclose(model.geom_solref[ids],[.002,1.])
+    assert np.allclose(model.geom_margin[ids],0.)
+    assert np.allclose(model.actuator_forcerange,[-.6405,.6405])
+    spec=mujoco.MjSpec();spec.worldbody.add_body(name='terrain')
+    HardFloorCfg(size=(4.,4.)).function(0.,spec,np.random.default_rng(0))
+    floor=spec.compile()
+    assert floor.geom_priority[0]==1
+    assert np.allclose(floor.geom_solref[0],[.002,1.])
+
+
+def test_running_start_and_61d_contract():
+    cfg=make_microduck_parkour_roll_env_cfg()
+    assert cfg.decimation*cfg.sim.mujoco.timestep==.02
+    assert cfg.scene.entities['robot'].init_state.pos[2]==.12
+    assert cfg.events['set_roulade_state'].params['forward_vel_range']==(0.,.55)
+    assert cfg.events['set_roulade_state'].params['standing_z_min']==.12
+    assert list(cfg.observations['actor'].terms)==['base_ang_vel','projected_gravity','joint_pos','joint_vel','actions','command','head_command','body_command']

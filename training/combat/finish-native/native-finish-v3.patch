new file mode 100644
index 0000000..b510780
--- /dev/null
+++ b/scripts/probe_duckfu_finish_teacher.py
@@ -0,0 +1,105 @@
+"""Measure full native-robot opposition before and after PPO; first episodes."""
+
+import argparse, json, time
+from pathlib import Path
+import numpy as np
+import torch
+import onnxruntime as ort
+import mjlab.tasks
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.tasks.registry import load_env_cfg
+from mjlab_microduck.tasks.mdp import (
+    _duckfu_finish_load_teacher,
+    duckfu_finish_target_out,
+    duckfu_finish_own_out,
+)
+
+p = argparse.ArgumentParser()
+p.add_argument("--policy", required=True)
+p.add_argument("--out", required=True)
+p.add_argument("--seed", type=int, default=1102)
+a = p.parse_args()
+start = time.monotonic()
+net, mean, std = _duckfu_finish_load_teacher(a.policy, "cuda:0")
+opts = ort.SessionOptions()
+opts.intra_op_num_threads = 1
+opts.inter_op_num_threads = 1
+s = ort.InferenceSession(
+    a.policy, sess_options=opts, providers=["CPUExecutionProvider"]
+)
+x = np.random.default_rng(1102).normal(size=(64, 61)).astype("float32")
+expected = np.concatenate(
+    [s.run(None, {s.get_inputs()[0].name: z[None]})[0] for z in x]
+)
+actual = net((torch.tensor(x, device="cuda:0") - mean) / std).detach().cpu().numpy()
+np.testing.assert_allclose(actual, expected, atol=1e-4, rtol=2e-4)
+cfg = load_env_cfg("Mjlab-DuckFu-Finish-MicroDuck-v1")
+cfg.scene.num_envs = 64
+cfg.auto_reset = False
+cfg.observations["actor"].enable_corruption = False
+env = ManagerBasedRlEnv(cfg, device="cuda:0")
+obs, _ = env.reset(seed=a.seed)
+done_once = torch.zeros(64, dtype=torch.bool, device="cuda:0")
+rows = []
+bodies = []
+for k in range(300):
+    with torch.inference_mode():
+        action = net((obs["actor"] - mean) / std)
+    obs, reward, term, timeout, extras = env.step(action)
+    robot, target = env.scene["robot"], env.scene["target"]
+    up = -robot.data.projected_gravity_b[:, 2]
+    if not torch.isfinite(obs["actor"]).all():
+        raise RuntimeError("Nonfinite observation")
+    bodies.append(
+        torch.stack(
+            (
+                robot.data.root_link_pos_w[:, 0] - env.scene.env_origins[:, 0],
+                target.data.root_link_pos_w[:, 0] - env.scene.env_origins[:, 0],
+                up,
+                -target.data.projected_gravity_b[:, 2],
+            ),
+            dim=1,
+        )
+        .cpu()
+        .numpy()
+    )
+    new = (term | timeout) & ~done_once
+    for i in new.nonzero().flatten().tolist():
+        rows.append(
+            dict(
+                environment=i,
+                time_s=(k + 1) * 0.02,
+                target_out=bool(duckfu_finish_target_out(env)[i]),
+                own_out=bool(duckfu_finish_own_out(env)[i]),
+                actor_up=float(up[i]),
+                ever_contact=bool(env._finish_ever_contact[i]),
+                qualified_win=bool(env._finish_win_paid[i]),
+                paid_frontier_m=float(env._finish_paid[i]),
+                opponent_style=int(env._finish_style[i]),
+                reward=float(reward[i]),
+            )
+        )
+    done_once |= new
+    if done_once.all():
+        break
+    ids = (term | timeout).nonzero().flatten()
+    if len(ids):
+        obs, _ = env.reset(env_ids=ids)
+result = dict(
+    policy=a.policy,
+    seed=a.seed,
+    rows=rows,
+    environments=64,
+    completed_first_episodes=int(done_once.sum()),
+    target_out=sum(r["target_out"] for r in rows),
+    supported_wins=sum(r["qualified_win"] for r in rows),
+    own_falls=sum(r["actor_up"] < 0.65 or r["own_out"] for r in rows),
+    median_paid_frontier_m=float(np.median([r["paid_frontier_m"] for r in rows])),
+    teacher_parity_max_error=float(abs(actual - expected).max()),
+    wall_s=time.monotonic() - start,
+)
+Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+Path(a.out).write_text(json.dumps(result, indent=2) + "\n")
+np.savez_compressed(Path(a.out).with_suffix(".npz"), body=np.array(bodies))
+print(json.dumps({k: v for k, v in result.items() if k != "rows"}, indent=2))
+env.close()

+import numpy as np
+import pytest
+from mjlab_microduck.tasks.microduck_duckfu_finish_env_cfg import (
+    make_duckfu_finish_env_cfg,
+    finish_robot_spec,
+    finish_target_spec,
+)
+
+
+def test_two_native_robots_keep_mass_joint_and_torque_contract():
+    a, b = finish_robot_spec().compile(), finish_target_spec().compile()
+    for m in [a, b]:
+        assert m.nu == 14 and m.nq == 21 and m.nv == 20
+        assert m.body_mass.sum() == pytest.approx(0.73724318)
+        assert np.allclose(m.actuator_forcerange, [-0.6405, 0.6405])
+    ea = a.geom_contype == 64
+    eb = b.geom_contype == 128
+    assert ea.sum() == eb.sum() == 70
+    assert (a.geom_conaffinity[ea] == 128).all() and (
+        b.geom_conaffinity[eb] == 64
+    ).all()
+
+
+def test_only_reset_moves_roots_and_actor_interface_stays_native():
+    c = make_duckfu_finish_env_cfg()
+    assert c.decimation * c.sim.mujoco.timestep == pytest.approx(0.02)
+    assert c.events["finish_reset"].mode == "reset"
+    assert c.events["finish_control"].mode == "step"
+    assert not any(e.mode == "interval" for e in c.events.values())
+    assert "finish_context" not in c.observations["actor"].terms
+    assert "finish_context" in c.observations["critic"].terms
+    assert (
+        c.rewards["finish_progress"].weight > 0 and c.rewards["finish_win"].weight > 0
+    )
+    assert c.rewards["finish_loss"].weight < 0 and c.rewards["finish_brake"].weight < 0
+    for n in ["feet_ground_contact", "finish_contact"]:
+        assert (
+            next(s for s in c.scene.sensors if s.name == n).history_length
+            == c.decimation
+        )
+    assert "supported_finish" in c.terminations and "own_out" in c.terminations
+

+)
diff --git a/src/mjlab_microduck/tasks/mdp.py b/src/mjlab_microduck/tasks/mdp.py
index 921244d..9611dd3 100644
--- a/src/mjlab_microduck/tasks/mdp.py
+++ b/src/mjlab_microduck/tasks/mdp.py
@@ -8475,3 +8475,212 @@ def duckfu_recovery_home_cost(env):
     up,height,_,supported = _duckfu_recovery_state(env)
     error = (robot.data.joint_pos[:,ids]-robot.data.default_joint_pos[:,ids]).square().mean(dim=1)
     return error*((up>0.94)&(height>0.105)&supported).float()
+
+
+# Native-robot finishing curriculum. Root/joint writes occur ONLY on reset.
+def _duckfu_finish_margin(env, asset):
+    xy=asset.data.root_link_pos_w[:,:2]-env.scene.env_origins[:,:2]
+    angles=torch.arange(8,device=env.device)*math.pi/4+math.pi/8
+    normals=torch.stack((angles.cos(),angles.sin()),dim=1)
+    return .85*math.cos(math.pi/8)-(xy@normals.T).amax(dim=1)
+
+
+def duckfu_finish_reset(env,env_ids):
+    n=len(env_ids)
+    if not hasattr(env,'_finish_origin'):
+        env._finish_origin=torch.zeros(env.num_envs,device=env.device)
+        env._finish_paid=torch.zeros(env.num_envs,device=env.device)
+        env._finish_touch_clock=torch.full((env.num_envs,),-100.,device=env.device)
+        env._finish_ever_contact=torch.zeros(env.num_envs,dtype=torch.bool,device=env.device)
+        env._finish_style=torch.zeros(env.num_envs,dtype=torch.long,device=env.device)
+        env._finish_teacher_last=torch.zeros((env.num_envs,14),device=env.device)
+        env._finish_drive_end=torch.zeros(env.num_envs,device=env.device)
+        env._finish_brake_latched=torch.zeros(env.num_envs,dtype=torch.bool,device=env.device)
+        env._finish_hold=torch.zeros(env.num_envs,device=env.device)
+        env._finish_complete=torch.zeros(env.num_envs,dtype=torch.bool,device=env.device)
+        env._finish_win_paid=torch.zeros(env.num_envs,dtype=torch.bool,device=env.device)
+        env._finish_result_step=torch.full((env.num_envs,),-1,dtype=torch.long,device=env.device)
+    target_x=torch.empty(n,device=env.device).uniform_(.46,.63)
+    gap=torch.empty(n,device=env.device).uniform_(.20,.32)
+    y=torch.empty(n,device=env.device).uniform_(-.035,.035)
+    for name,x in [('robot',target_x-gap),('target',target_x)]:
+        asset=env.scene[name]
+        pose=asset.data.default_root_state[env_ids,:7].clone()
+        pose[:,:3]=env.scene.env_origins[env_ids]+torch.stack((x,y,torch.full_like(x,.12)),dim=1)
+        yaw=torch.empty(n,device=env.device).uniform_(-.12,.12)
+        if name=='target':yaw+=torch.randint(0,4,(n,),device=env.device)*math.pi/2
+        pose[:,3:]=0.
+        pose[:,3]=torch.cos(yaw/2);pose[:,6]=torch.sin(yaw/2)
+        asset.write_root_link_pose_to_sim(pose,env_ids=env_ids)
+        asset.write_root_link_velocity_to_sim(torch.zeros((n,6),device=env.device),env_ids=env_ids)
+        ids=_servo_joint_ids(env,asset)
+        joints=asset.data.default_joint_pos[env_ids][:,ids]+torch.empty((n,14),device=env.device).uniform_(-.005,.005)
+        asset.write_joint_state_to_sim(joints,torch.zeros_like(joints),joint_ids=ids,env_ids=env_ids)
+        asset.set_joint_position_target(asset.data.default_joint_pos[env_ids][:,ids],joint_ids=ids,env_ids=env_ids[:,None])
+    env._finish_origin[env_ids]=target_x
+    env._finish_paid[env_ids]=0.
+    env._finish_hold[env_ids]=0.
+    env._finish_complete[env_ids]=False
+    env._finish_win_paid[env_ids]=False
+    env._finish_result_step[env_ids]=-1
+    env._finish_touch_clock[env_ids]=-100.
+    env._finish_ever_contact[env_ids]=False
+    env._finish_teacher_last[env_ids]=0.
+    # Frozen opponent pool. A walk opponent may step inward or sideways using
+    # bounded native locomotion commands; it never receives an external shove.
+    walk_fraction=.25 if env.common_step_counter<3600 else .50
+    env._finish_style[env_ids]=(torch.rand(n,device=env.device)<walk_fraction).long()
+    env._finish_brake_latched[env_ids]=False
+    # Frequent short drives expose braking before rare successful ring-outs.
+    short_fraction=.50 if env.common_step_counter<2400 else .25
+    short=torch.rand(n,device=env.device)<short_fraction
+    env._finish_drive_end[env_ids]=torch.where(short,
+        torch.empty(n,device=env.device).uniform_(1.2,2.0),
+        torch.empty(n,device=env.device).uniform_(2.7,3.1))
+
+
+def _duckfu_finish_load_teacher(path,device):
+    import onnx
+    from onnx import numpy_helper
+    from torch import nn
+    values={x.name:torch.as_tensor(numpy_helper.to_array(x).copy(),device=device) for x in onnx.load(path).graph.initializer}
+    net=nn.Sequential(nn.Linear(61,512),nn.ELU(),nn.Linear(512,256),nn.ELU(),nn.Linear(256,128),nn.ELU(),nn.Linear(128,14)).to(device)
+    net.load_state_dict({k.removeprefix('mlp.'):v for k,v in values.items() if k.startswith('mlp.')})
+    divisors=[v for k,v in values.items() if k.startswith('onnx::Div')]
+    if len(divisors)!=1:raise ValueError('Unexpected teacher normalization graph')
+    net.eval()
+    for p in net.parameters():p.requires_grad_(False)
+    return net,values['obs_normalizer._mean'],divisors[0]
+
+
+def _duckfu_finish_direction(asset,delta):
+    q=asset.data.root_link_quat_w
+    yaw=torch.atan2(2*(q[:,0]*q[:,3]+q[:,1]*q[:,2]),1-2*(q[:,2].square()+q[:,3].square()))
+    x=yaw.cos()*delta[:,0]+yaw.sin()*delta[:,1]
+    y=-yaw.sin()*delta[:,0]+yaw.cos()*delta[:,1]
+    return x,y,torch.atan2(y,x)
+
+
+def duckfu_finish_drive_command(env):
+    """A public-state coach requests braking; actor keeps its native 61D input.
+
+    Arena coordinates are not in the actor observation. Asking it to infer an
+    invisible edge while holding a forward command is an inconsistent task.
+    Latch zero commands at a conservative inner margin, like runtime preemption.
+    """
+    t=env.episode_length_buf*env.step_dt
+    edge=(_duckfu_finish_margin(env,env.scene['robot'])<.14)&(t>=.60)
+    env._finish_brake_latched|=edge|duckfu_finish_target_out(env)
+    return (t>=.60)&(t<env._finish_drive_end)&~env._finish_brake_latched
+
+
+def duckfu_finish_control(env,env_ids=None,stand_path='',walk_path=''):
+    if not stand_path or not walk_path:
+        raise ValueError('Finishing task requires explicit frozen opponent motor paths')
+    if not hasattr(env,'_finish_teachers'):
+        env._finish_teachers=[_duckfu_finish_load_teacher(p,env.device) for p in (stand_path,walk_path)]
+    robot,target=env.scene['robot'],env.scene['target']
+    t=env.episode_length_buf*env.step_dt
+    active=duckfu_finish_drive_command(env)
+    twist=env.command_manager.get_term('twist').command
+    twist.zero_();twist[:,0]=active.float()*.4
+    _,_,angle=_duckfu_finish_direction(robot,target.data.root_link_pos_w[:,:2]-robot.data.root_link_pos_w[:,:2])
+    twist[:,2]=torch.clamp(2*angle,-.5,.5)*active
+    head=env.command_manager.get_term('head_pose').command
+    head.zero_();head[:,0]=-.3*active;head[:,1]=-.15*active
+    env.command_manager.get_term('body_pose').command.zero_()
+    command=torch.zeros((env.num_envs,13),device=env.device)
+    tx,ty,ta=_duckfu_finish_direction(target,robot.data.root_link_pos_w[:,:2]-target.data.root_link_pos_w[:,:2])
+    gap=torch.sqrt(tx.square()+ty.square()).clamp(min=1e-6)
+    command[:,0]=torch.clamp(tx/gap*.14,-.14,.14)
+    command[:,1]=torch.clamp(ty/gap*.14,-.14,.14)
+    command[:,2]=torch.clamp(2*ta,-1.,1.)
+    command*=((t>.60)&(t<env._finish_drive_end+.4))[:,None]
+    ids=_servo_joint_ids(env,target)
+    obs=torch.cat((target.data.root_link_ang_vel_b,target.data.projected_gravity_b,
+        _servo_joint_pos(env,target)-_servo_default_joint_pos(env,target),_servo_joint_vel(env,target),env._finish_teacher_last,command),dim=1)
+    stand_obs=obs.clone();stand_obs[:,48:]=0.
+    with torch.no_grad():
+        stand,walk=env._finish_teachers
+        a=stand[0]((stand_obs-stand[1])/stand[2])
+        b=walk[0]((obs-walk[1])/walk[2])
+        action=torch.where((env._finish_style==0)[:,None],a,b)
+    if not torch.isfinite(action).all():raise RuntimeError('Nonfinite native opponent action')
+    target.set_joint_position_target(_servo_default_joint_pos(env,target)+action,joint_ids=ids)
+    env._finish_teacher_last.copy_(action)
+
+
+def duckfu_finish_critic(env):
+    robot,target=env.scene['robot'],env.scene['target']
+    delta=target.data.root_link_pos_w[:,:2]-robot.data.root_link_pos_w[:,:2]
+    x,y,_=_duckfu_finish_direction(robot,delta)
+    target_up=-target.data.projected_gravity_b[:,2]
+    t=env.episode_length_buf*env.step_dt
+    return torch.cat((torch.stack((x,y,target_up,_duckfu_finish_margin(env,robot),_duckfu_finish_margin(env,target),t/5.6,(env.command_manager.get_term('twist').command.norm(dim=1)>1e-5).float()),dim=1),target.data.root_link_lin_vel_w[:,:2]),dim=1)
+
+
+def _duckfu_finish_supported(env):
+    history=env.scene.sensors['feet_ground_contact'].data.force_history
+    if history is None:raise ValueError('Need whole-period solved foot support')
+    return history[...,2].abs().mean(-1).sum(-1)>.5
+
+
+def duckfu_finish_progress(env):
+    robot,target=env.scene['robot'],env.scene['target']
+    force=env.scene.sensors['finish_contact'].data.force_history
+    if force is None:raise ValueError('Need actual opponent contact history')
+    contact=force.norm(dim=-1).mean(-1).sum(-1)>.25
+    t=env.episode_length_buf*env.step_dt
+    env._finish_touch_clock=torch.where(contact,t,env._finish_touch_clock)
+    env._finish_ever_contact|=contact
+    progress=(target.data.root_link_pos_w[:,0]-env.scene.env_origins[:,0]-env._finish_origin).clamp(0.,.45)
+    delta=(progress-env._finish_paid).clamp(0.,.5*env.step_dt)
+    good=((-robot.data.projected_gravity_b[:,2])>.90)&_duckfu_finish_supported(env)&(_duckfu_finish_margin(env,robot)>.06)&(t-env._finish_touch_clock<.30)
+    delta*=good
+    env._finish_paid+=delta
+    return delta/env.step_dt
+
+
+def duckfu_finish_target_out(env):
+    return env.scene['target'].data.root_link_pos_w[:,2]-env.scene.env_origins[:,2]<-.10
+
+
+def duckfu_finish_own_out(env):
+    return env.scene['robot'].data.root_link_pos_w[:,2]-env.scene.env_origins[:,2]<-.10
+
+
+def duckfu_finish_win(env):
+    complete=duckfu_finish_complete(env)
+    paid=complete&~env._finish_win_paid
+    env._finish_win_paid|=paid
+    return paid.float()/env.step_dt
+
+
+def duckfu_finish_loss(env):
+    fallen=(-env.scene['robot'].data.projected_gravity_b[:,2])<.65
+    return (duckfu_finish_own_out(env)|fallen).float()/env.step_dt
+
+
+def duckfu_finish_brake(env):
+    late=(env.command_manager.get_term('twist').command.norm(dim=1)<1e-5)&(env.episode_length_buf*env.step_dt>.65)
+    speed=env.scene['robot'].data.root_link_lin_vel_w[:,:2].square().sum(-1)
+    return speed*late
+
+
+def duckfu_finish_complete(env):
+    """An exit is not enough: require the attacker to brake and keep support.
+
+    Cache per global motor tick because termination and reward both query it.
+    The one-shot reward has a separate paid latch; no repeated win annuity.
+    """
+    fresh=env._finish_result_step!=env.common_step_counter
+    robot=env.scene['robot']
+    good=(duckfu_finish_target_out(env)&env._finish_ever_contact
+          &((-robot.data.projected_gravity_b[:,2])>.94)&_duckfu_finish_supported(env)
+          &(_duckfu_finish_margin(env,robot)>.06)
+          &(robot.data.root_link_lin_vel_w[:,:2].norm(dim=1)<.16))
+    hold=torch.where(good,env._finish_hold+env.step_dt,0.)
+    env._finish_hold=torch.where(fresh,hold,env._finish_hold)
+    env._finish_complete=env._finish_hold>=.30-1e-6
+    env._finish_result_step=torch.where(fresh,torch.full_like(env._finish_result_step,env.common_step_counter),env._finish_result_step)
+    return env._finish_complete

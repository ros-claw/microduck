+# Native opponent finishing motor, optional simulation curriculum.
+from .microduck_duckfu_finish_env_cfg import make_duckfu_finish_env_cfg, DuckFuFinishRlCfg
+register_mjlab_task(
+    task_id='Mjlab-DuckFu-Finish-MicroDuck-v1',
+    env_cfg=make_duckfu_finish_env_cfg(),play_env_cfg=make_duckfu_finish_env_cfg(play=True),

+def fake_finish_env():
+    from types import SimpleNamespace as NS
+    import torch
+
+    class Scene(dict):
+        pass
+
+    a = NS(
+        data=NS(
+            root_link_pos_w=torch.tensor([[0.25, 0.0, 0.12]]),
+            root_link_lin_vel_w=torch.zeros((1, 3)),
+            projected_gravity_b=torch.tensor([[0.0, 0.0, -1.0]]),
+        )
+    )
+    b = NS(
+        data=NS(
+            root_link_pos_w=torch.tensor([[0.5, 0.0, 0.12]]),
+            projected_gravity_b=torch.tensor([[0.0, 0.0, -1.0]]),
+        )
+    )
+    feet = torch.zeros((1, 2, 40, 3))
+    feet[:, :, :, 2] = 4.0
+    contact = torch.zeros((1, 1, 40, 3))
+    contact[:, :, :, 0] = 1.0
+    scene = Scene(robot=a, target=b)
+    scene.env_origins = torch.zeros((1, 3))
+    scene.sensors = {
+        "feet_ground_contact": NS(data=NS(force_history=feet)),
+        "finish_contact": NS(data=NS(force_history=contact)),
+    }
+    return NS(
+        scene=scene,
+        device="cpu",
+        step_dt=0.02,
+        common_step_counter=0,
+        _finish_hold=torch.zeros(1),
+        _finish_complete=torch.tensor([False]),
+        _finish_win_paid=torch.tensor([False]),
+        _finish_result_step=torch.tensor([-1]),
+        episode_length_buf=torch.tensor([10]),
+        _finish_origin=torch.tensor([0.5]),
+        _finish_paid=torch.zeros(1),
+        _finish_touch_clock=torch.tensor([-100.0]),
+        _finish_ever_contact=torch.tensor([False]),
+    )
+
+
+def test_progress_requires_real_contact_and_support_and_cannot_farm_a_hold():
+    from mjlab_microduck.tasks import mdp
+
+    e = fake_finish_env()
+    assert mdp.duckfu_finish_progress(e).item() == 0
+    e.scene["target"].data.root_link_pos_w[:, 0] += 0.02
+    assert mdp.duckfu_finish_progress(e).item() == pytest.approx(0.5)
+    assert mdp.duckfu_finish_progress(e).item() == pytest.approx(0.5, abs=1e-5)
+    assert mdp.duckfu_finish_progress(e).item() == pytest.approx(0, abs=1e-5)
+    e.scene["target"].data.root_link_pos_w[:, 0] -= 0.02
+    assert mdp.duckfu_finish_progress(e).item() == 0
+    e.scene["target"].data.root_link_pos_w[:, 0] += 0.02
+    assert mdp.duckfu_finish_progress(e).item() == pytest.approx(0, abs=1e-5)
+
+
+@pytest.mark.parametrize("failure", ["no_contact", "no_support", "fallen", "own_edge"])
+def test_flying_flopping_or_unrelated_opponent_movement_does_not_pay(failure):
+    from mjlab_microduck.tasks import mdp
+
+    e = fake_finish_env()
+    e.scene["target"].data.root_link_pos_w[:, 0] += 0.04
+    if failure == "no_contact":
+        e.scene.sensors["finish_contact"].data.force_history.zero_()
+    if failure == "no_support":
+        e.scene.sensors["feet_ground_contact"].data.force_history.zero_()
+    if failure == "fallen":
+        e.scene["robot"].data.projected_gravity_b[:, 2] = 0.0
+    if failure == "own_edge":
+        e.scene["robot"].data.root_link_pos_w[:, 0] = 0.82
+    assert mdp.duckfu_finish_progress(e).item() == 0
+
+
+def test_target_ringout_requires_continuous_post_exit_support_and_pays_once():
+    from mjlab_microduck.tasks import mdp
+
+    e = fake_finish_env()
+    e.scene["target"].data.root_link_pos_w[:, 2] = -0.2
+    assert mdp.duckfu_finish_target_out(e).item()
+    assert mdp.duckfu_finish_win(e).item() == 0
+
+    mdp.duckfu_finish_progress(e)
+    for i in range(1, 15):
+        e.common_step_counter = i
+        assert mdp.duckfu_finish_win(e).item() == 0
+        # Re-reading termination and reward in the same tick must not accrue
+        # another tick of virtual support.
+        mdp.duckfu_finish_complete(e)
+    e.common_step_counter = 15
+    assert mdp.duckfu_finish_win(e).item() == pytest.approx(50.0)
+    assert mdp.duckfu_finish_win(e).item() == 0
+    e.scene["robot"].data.root_link_pos_w[:, 2] = -0.2
+    e.common_step_counter = 16
+    assert mdp.duckfu_finish_win(e).item() == 0
+
+
+def test_invisible_edge_is_handled_by_a_latched_public_coach_command():
+    import torch
+    from mjlab_microduck.tasks import mdp
+
+    e = fake_finish_env()
+    e.episode_length_buf[:] = 50
+    e._finish_drive_end = torch.tensor([3.0])
+    e._finish_brake_latched = torch.tensor([False])
+    assert mdp.duckfu_finish_drive_command(e).item()
+    e.scene["robot"].data.root_link_pos_w[:, 0] = 0.72
+    assert not mdp.duckfu_finish_drive_command(e).item()
+    # Coasting inward does not oscillate between forward and braking commands.
+    e.scene["robot"].data.root_link_pos_w[:, 0] = 0.60
+    assert not mdp.duckfu_finish_drive_command(e).item()
+
+
+def test_real_exit_and_short_drive_timeout_both_request_zero_motor_command():
+    import torch
+    from mjlab_microduck.tasks import mdp
+
+    e = fake_finish_env()
+    e.episode_length_buf[:] = 50
+    e._finish_drive_end = torch.tensor([0.9])
+    e._finish_brake_latched = torch.tensor([False])
+    assert not mdp.duckfu_finish_drive_command(e).item()
+    e._finish_drive_end[:] = 3.0
+    assert mdp.duckfu_finish_drive_command(e).item()
+    e.scene["target"].data.root_link_pos_w[:, 2] = -0.2
+    assert not mdp.duckfu_finish_drive_command(e).item()

@@ -0,0 +1,193 @@
+"""Native opponent curriculum: supported pressure, real edge exits and braking.
+
+The actor retains 61 physical observations. A frozen native robot opposes it;
+only the critic sees privileged relative geometry. No in-episode root writes.
+"""
+
+from copy import deepcopy
+from dataclasses import dataclass
+import math
+import os
+
+import mujoco
+import numpy as np
+from mjlab.managers import (
+    EventTermCfg,
+    RewardTermCfg,
+    TerminationTermCfg,
+    ObservationTermCfg,
+)
+from mjlab.sensor import ContactSensorCfg, ContactMatch
+from mjlab.terrains.terrain_generator import TerrainGeometry, TerrainOutput
+
+from .microduck_duckfu_env_cfg import (
+    DuckFuFloor,
+    DuckFuRlCfg,
+    make_duckfu_contact_env_cfg,
+)
+from mjlab_microduck.robot.microduck_constants import (
+    MICRODUCK_STANDUP_PD_ROBOT_CFG,
+    get_standup_spec,
+)
+from . import mdp
+
+
+def finish_robot_spec(index=0):
+    from microduck_lab.combat.world import external_parts
+
+    s = get_standup_spec()
+    external_parts(s, index, 2)
+    for a in s.actuators:
+        a.forcelimited = True
+        a.forcerange = [-0.6405, 0.6405]
+    for g in s.geoms:
+        if g.contype or g.conaffinity:
+            g.solref = [0.0005, 1.0]
+            g.solimp = [0.99, 0.99, 0.001, 0.5, 2.0]
+            g.margin = 0.0
+    return s
+
+
+def finish_target_spec():
+    s = finish_robot_spec(1)
+    # The CPU forward used by Warp allocation precedes reset events. Keep the
+    # two compile-time free roots apart instead of allocating overlapping ducks.
+    s.body("trunk_base").pos[0] = 0.5
+    return s
+
+
+@dataclass(kw_only=True)
+class FinishRing(DuckFuFloor):
+    def function(self, difficulty, spec, rng):
+        ox, oy = self.size[0] / 2, self.size[1] / 2
+        vertices = [
+            [0.85 * math.cos(i * math.pi / 4), 0.85 * math.sin(i * math.pi / 4), z]
+            for z in (-0.04, 0.04)
+            for i in range(8)
+        ]
+        spec.add_mesh(
+            name="finish_octagon", uservert=np.asarray(vertices).flatten().tolist()
+        )
+        stage = spec.body("terrain").add_geom(
+            name="finish_stage",
+            type=mujoco.mjtGeom.mjGEOM_MESH,
+            meshname="finish_octagon",
+            pos=[ox, oy, -0.04],
+            contype=1,
+            conaffinity=20,
+            friction=[1.0, 0.005, 0.0001],
+            solref=[0.0005, 1.0],
+            solimp=[0.99, 0.99, 0.001, 0.5, 2.0],
+        )
+        receiver = spec.body("terrain").add_geom(
+            name="finish_receiver",
+            type=mujoco.mjtGeom.mjGEOM_BOX,
+            pos=[ox, oy, -0.55],
+            size=[self.size[0] / 2, self.size[1] / 2, 0.04],
+            contype=1,
+            conaffinity=20,
+            friction=[1.0, 0.005, 0.0001],
+            solref=[0.0005, 1.0],
+            solimp=[0.99, 0.99, 0.001, 0.5, 2.0],
+        )
+        return TerrainOutput(
+            origin=np.array([ox, oy, 0.0]),
+            geometries=[
+                TerrainGeometry(geom=stage, color=(0.4, 0.4, 0.4, 1)),
+                TerrainGeometry(geom=receiver, color=(0.1, 0.1, 0.1, 1)),
+            ],
+        )
+
+
+def make_duckfu_finish_env_cfg(play=False):
+    cfg = make_duckfu_contact_env_cfg(play=play)
+    cfg.scene.entities["robot"].spec_fn = finish_robot_spec
+    target = deepcopy(MICRODUCK_STANDUP_PD_ROBOT_CFG)
+    target.spec_fn = finish_target_spec
+    target.collisions = ()
+    target.init_state.pos = (0.5, 0.0, 0.12)
+    cfg.scene.entities["target"] = target
+    cfg.scene.terrain.terrain_generator.sub_terrains = {"ring": FinishRing()}
+    cfg.sim.nconmax = 512
+    cfg.sim.njmax = 10000
+    cfg.episode_length_s = 5.6
+    cfg.terminations["fell_over"].params["limit_angle"] = math.acos(0.65)
+    twist = cfg.commands["twist"]
+    twist.ranges.lin_vel_x = twist.ranges.lin_vel_y = twist.ranges.ang_vel_z = (
+        0.0,
+        0.0,
+    )
+    for name in ("head_pose", "body_pose"):
+        cfg.commands[name].ranges = tuple((0.0, 0.0) for _ in cfg.commands[name].ranges)
+    for sensor in cfg.scene.sensors:
+        if sensor.name == "feet_ground_contact":
+            sensor.history_length = cfg.decimation
+    cfg.scene.sensors = (
+        *cfg.scene.sensors,
+        ContactSensorCfg(
+            name="finish_contact",
+            primary=ContactMatch(mode="subtree", entity="robot", pattern="trunk_base"),
+            secondary=ContactMatch(
+                mode="subtree", entity="target", pattern="trunk_base"
+            ),
+            fields=("found", "force"),
+            reduce="netforce",
+            global_frame=True,
+            history_length=cfg.decimation,
+        ),
+    )
+    for name in ("reset_base", "reset_robot_joints", "reset_target", "duckfu_commands"):
+        cfg.events.pop(name, None)
+    cfg.events["finish_reset"] = EventTermCfg(
+        func=mdp.duckfu_finish_reset, mode="reset"
+    )
+    cfg.events["finish_control"] = EventTermCfg(
+        func=mdp.duckfu_finish_control,
+        mode="step",
+        params={
+            "stand_path": os.environ.get("DUCKFU_STAND_TEACHER", ""),
+            "walk_path": os.environ.get("DUCKFU_WALK_TEACHER", ""),
+        },
+    )
+    for group in ("actor", "critic"):
+        # Disabled delays were inherited from the matched contact task.
+        assert len(cfg.observations[group].terms) > 0
+    cfg.observations["critic"].terms["finish_context"] = ObservationTermCfg(
+        func=mdp.duckfu_finish_critic
+    )
+    original = cfg.rewards
+    cfg.rewards = {
+        k: deepcopy(original[k])
+        for k in ("upright", "head_pose_tracking", "action_rate_l2", "dof_pos_limits")
+        if k in original
+    }
+    cfg.rewards["action_rate_l2"].weight = -0.005
+    cfg.rewards["upright"].weight = 0.4
+    cfg.rewards["head_pose_tracking"].weight = 0.8
+    cfg.rewards["track_linear_velocity"] = deepcopy(original["track_linear_velocity"])
+    cfg.rewards["track_linear_velocity"].weight = 2.0
+    cfg.rewards["finish_progress"] = RewardTermCfg(
+        func=mdp.duckfu_finish_progress, weight=30.0
+    )
+    cfg.rewards["finish_win"] = RewardTermCfg(func=mdp.duckfu_finish_win, weight=20.0)
+    cfg.rewards["finish_loss"] = RewardTermCfg(
+        func=mdp.duckfu_finish_loss, weight=-25.0
+    )
+    cfg.rewards["finish_brake"] = RewardTermCfg(
+        func=mdp.duckfu_finish_brake, weight=-2.0
+    )
+    cfg.rewards["finish_stable"] = RewardTermCfg(func=mdp.duckfu_stable, weight=0.3)
+    cfg.terminations["supported_finish"] = TerminationTermCfg(
+        func=mdp.duckfu_finish_complete
+    )
+    cfg.terminations["own_out"] = TerminationTermCfg(func=mdp.duckfu_finish_own_out)
+    return cfg
+
+
+DuckFuFinishRlCfg = deepcopy(DuckFuRlCfg)
+DuckFuFinishRlCfg.experiment_name = "duckfu_finish"
+DuckFuFinishRlCfg.run_name = "native_opponent_pressure"
+DuckFuFinishRlCfg.save_interval = 50
+DuckFuFinishRlCfg.max_iterations = 601
+DuckFuFinishRlCfg.algorithm.learning_rate = 1e-4
+DuckFuFinishRlCfg.actor.distribution_cfg["init_std"] = 0.12

@@ -0,0 +1,68 @@
+"""Verify real predecessor state/history survives the actual mjlab reset."""
+
+import argparse
+import json
+from pathlib import Path
+import torch
+import mjlab.tasks  # noqa: F401
+from mjlab.envs import ManagerBasedRlEnv
+from mjlab.tasks.registry import load_env_cfg
+from mjlab_microduck.tasks.mdp import _servo_joint_ids
+
+p = argparse.ArgumentParser()
+p.add_argument("--out", required=True)
+a = p.parse_args()
+cfg = load_env_cfg("Mjlab-DuckFu-Recovery-MicroDuck-v1")
+cfg.scene.num_envs = 64
+cfg.observations["actor"].enable_corruption = False
+env = ManagerBasedRlEnv(cfg, device="cuda:0")
+obs, _ = env.reset()
+torch.testing.assert_close(
+    obs["actor"][:, 34:48], env._df_recovery_last, rtol=0, atol=0
+)
+robot = env.scene["robot"]
+ids = _servo_joint_ids(env, robot)
+actual = torch.cat(
+    (
+        robot.data.root_link_pos_w - env.scene.env_origins,
+        robot.data.root_link_quat_w,
+        robot.data.root_link_lin_vel_w,
+        robot.data.root_link_ang_vel_w,
+        robot.data.joint_pos[:, ids],
+        robot.data.joint_vel[:, ids],
+        env._df_recovery_last,
+    ),
+    dim=1,
+)
+pool = env._df_recovery_pool
+expected = torch.cat(
+    (pool["root"], pool["joints"], pool["joint_velocity"], pool["last_action"]), dim=1
+)
+error = (
+    (actual[:, None, :] - expected[None, :, :])
+    .abs()
+    .max(dim=2)
+    .values.min(dim=1)
+    .values
+)
+assert error.max() < 1e-5, error.max()
+assert obs["actor"].shape == (64, 61)
+assert (robot.data.joint_vel[:, ids].abs() > 0.1).any()
+Path(a.out).write_text(
+    json.dumps(
+        dict(
+            passed=True,
+            environments=64,
+            actor_observation_shape=list(obs["actor"].shape),
+            exact_predecessor_action_history=True,
+            maximum_state_reset_error=float(error.max()),
+            maximum_initial_joint_speed=float(robot.data.joint_vel[:, ids].abs().max()),
+        ),
+        indent=2,
+    )
+    + "\n"
+)
+env.close()
+print(
+    "Recorded root/joint state, momentum and first-observation action history verified."
+)

+++ b/src/mjlab_microduck/tasks/microduck_duckfu_recovery_env_cfg.py
@@ -0,0 +1,77 @@
+"""Matched-PD recovery from real contact/stumble predecessor states."""
+
+from copy import deepcopy
+import os
+
+from mjlab.managers import EventTermCfg, RewardTermCfg, TerminationTermCfg
+from .microduck_duckfu_env_cfg import make_duckfu_locomotion_env_cfg, DuckFuRlCfg
+from . import mdp
+
+
+def make_duckfu_recovery_env_cfg(play=False):
+    cfg = make_duckfu_locomotion_env_cfg(play=play)
+    cfg.episode_length_s = 4.0
+    # Use real solved contacts throughout the motor period. A final-substep
+    # sample aliases stiff foot contacts and makes stable support look airborne.
+    for sensor in cfg.scene.sensors:
+        if sensor.name == "feet_ground_contact":
+            sensor.history_length = cfg.decimation
+    cfg.events.pop("reset_base")
+    cfg.events.pop("reset_robot_joints")
+    cfg.events.pop("duckfu_commands")
+    cfg.events["recorded_recovery_reset"] = EventTermCfg(
+        func=mdp.duckfu_recorded_recovery_reset,
+        mode="reset",
+        params={
+            "states_path": os.environ.get(
+                "MICRODUCK_RECOVERY_STATES", "data/duckfu_recovery/development.npz"
+            )
+        },
+    )
+    cfg.terminations.pop("fell_over", None)
+    cfg.terminations["invalid_state"] = TerminationTermCfg(
+        func=mdp.root_state_sane,
+        params={"max_abs_xy": 1.0, "z_range": (-0.05, 0.8), "max_joint_vel": 200.0},
+    )
+    for name in ("actor", "critic"):
+        cfg.observations[name].terms["actions"].func = mdp.duckfu_recorded_last_action
+    command = cfg.commands["twist"]
+    command.ranges.lin_vel_x = command.ranges.lin_vel_y = command.ranges.ang_vel_z = (
+        0.0,
+        0.0,
+    )
+    command.rel_standing_envs = 1.0
+    for name in ("head_pose", "body_pose"):
+        cfg.commands[name].ranges = tuple((0.0, 0.0) for _ in cfg.commands[name].ranges)
+    original = cfg.rewards
+    cfg.rewards = {
+        k: deepcopy(original[k]) for k in ("dof_pos_limits", "self_collisions")
+    }
+    cfg.rewards["self_collisions"].weight = -0.5
+    cfg.rewards["progress"] = RewardTermCfg(
+        func=mdp.duckfu_recovery_progress, weight=2.0
+    )
+    cfg.rewards["standing"] = RewardTermCfg(
+        func=mdp.duckfu_recovery_standing, weight=8.0
+    )
+    cfg.rewards["completion"] = RewardTermCfg(
+        func=mdp.duckfu_recovery_completion, weight=1.0
+    )
+    cfg.rewards["unfinished"] = RewardTermCfg(
+        func=mdp.duckfu_recovery_unfinished, weight=-0.25
+    )
+    cfg.rewards["action_rate"] = RewardTermCfg(
+        func=mdp.duckfu_recorded_action_rate, weight=-0.005
+    )
+    cfg.rewards["home_cost"] = RewardTermCfg(
+        func=mdp.duckfu_recovery_home_cost, weight=-0.2
+    )
+    return cfg
+
+
+DuckFuRecoveryRlCfg = deepcopy(DuckFuRlCfg)
+DuckFuRecoveryRlCfg.experiment_name = "duckfu_recovery"
+DuckFuRecoveryRlCfg.run_name = "recorded_contact_predecessors_v1"
+DuckFuRecoveryRlCfg.save_interval = 50
+DuckFuRecoveryRlCfg.max_iterations = 301
+DuckFuRecoveryRlCfg.actor.distribution_cfg["init_std"] = 0.15
diff --git a/tests/test_duckfu_recovery_cfg.py b/tests/test_duckfu_recovery_cfg.py
new file mode 100644
index 0000000..6745178
--- /dev/null
+++ b/tests/test_duckfu_recovery_cfg.py
@@ -0,0 +1,119 @@
+from types import SimpleNamespace
+import json
+import torch
+import pytest
+
+from mjlab_microduck.tasks.microduck_duckfu_recovery_env_cfg import (
+    make_duckfu_recovery_env_cfg,
+)
+from mjlab_microduck.tasks import mdp
+
+
+def fake_env(up=1.0, height=0.117, force=4.0, speed=0.0):
+    import math
+
+    quat = torch.tensor([[math.sqrt((1 + up) / 2), math.sqrt((1 - up) / 2), 0.0, 0.0]])
+    data = SimpleNamespace(
+        root_link_quat_w=quat,
+        root_link_pos_w=torch.tensor([[0.0, 0.0, height]]),
+        root_link_lin_vel_w=torch.tensor([[speed, 0.0, 0.0]]),
+    )
+    sensor = SimpleNamespace(
+        found=torch.ones((1, 2, 1)),
+        force=torch.tensor([[[[0.0, 0.0, force]], [[0.0, 0.0, force]]]]),
+        force_history=torch.tensor([[[[0.0, 0.0, force]] * 40] * 2]),
+    )
+
+    class Scene(dict):
+        pass
+
+    scene = Scene(robot=SimpleNamespace(data=data))
+    scene.env_origins = torch.zeros((1, 3))
+    scene.sensors = {"feet_ground_contact": SimpleNamespace(data=sensor)}
+    return SimpleNamespace(
+        scene=scene,
+        num_envs=1,
+        device="cpu",
+        episode_length_buf=torch.tensor([2]),
+        step_dt=0.02,
+    )
+
+
+def test_recovery_uses_recorded_reset_and_survives_actual_falls():
+    cfg = make_duckfu_recovery_env_cfg()
+    assert "fell_over" not in cfg.terminations
+    assert "nan_state" in cfg.terminations and "invalid_state" in cfg.terminations
+    assert cfg.events["recorded_recovery_reset"].mode == "reset"
+    assert "reset_base" not in cfg.events and "reset_robot_joints" not in cfg.events
+    assert not any(e.mode == "interval" for e in cfg.events.values())
+    for group in ("actor", "critic"):
+        assert (
+            cfg.observations[group].terms["actions"].func
+            == mdp.duckfu_recorded_last_action
+        )
+    assert cfg.rewards["action_rate"].weight < 0 and cfg.rewards["standing"].weight > 0
+    sensor = next(s for s in cfg.scene.sensors if s.name == "feet_ground_contact")
+    assert sensor.history_length == cfg.decimation
+
+
+@pytest.mark.parametrize(
+    "args", [dict(up=-0.5), dict(height=0.08), dict(force=0.0), dict(speed=0.3)]
+)
+def test_stable_flops_and_unsupported_flight_do_not_earn_standing_or_completion(args):
+    env = fake_env(**args)
+    assert mdp.duckfu_recovery_standing(env).item() == 0
+    assert sum(mdp.duckfu_recovery_completion(env).item() for _ in range(100)) == 0
+
+
+def test_completion_requires_continuous_support_and_pays_once():
+    env = fake_env()
+    for _ in range(14):
+        assert mdp.duckfu_recovery_completion(env).item() == 0
+    assert mdp.duckfu_recovery_completion(env).item() == pytest.approx(50)
+    assert sum(mdp.duckfu_recovery_completion(env).item() for _ in range(50)) == 0
+
+
+def test_holding_a_fallen_pose_has_zero_progress():
+    env = fake_env(up=0.2, height=0.06)
+    assert mdp.duckfu_recovery_progress(env).item() == 0
+    assert mdp.duckfu_recovery_progress(env).item() == 0
+    env.scene["robot"].data.root_link_pos_w[:, 2] += 0.01
+    assert mdp.duckfu_recovery_progress(env).item() > 0
+    env.scene["robot"].data.root_link_pos_w[:, 2] -= 0.01
+    assert mdp.duckfu_recovery_progress(env).item() < 0
+
+
+def test_support_is_measured_over_the_motor_period_instead_of_last_substep():
+    env = fake_env()
+    sensor = env.scene.sensors["feet_ground_contact"].data
+    sensor.force.zero_()
+    sensor.found.zero_()
+    sensor.force_history[:, :, ::2, :] = 0
+    assert mdp.duckfu_recovery_standing(env).item() == pytest.approx(1)
+    sensor.force_history.zero_()
+    sensor.force.fill_(20)
+    assert mdp.duckfu_recovery_standing(env).item() == 0
+
+
+def test_initial_history_is_the_real_predecessor_output():
+    action = torch.zeros((2, 14))
+    initial = torch.full_like(action, 0.6)
+    env = SimpleNamespace(
+        action_manager=SimpleNamespace(action=action, prev_action=action.clone()),
+        episode_length_buf=torch.tensor([0, 2]),
+        _df_recovery_last=initial,
+    )
+    assert torch.all(mdp.duckfu_recorded_last_action(env)[0] == 0.6)
+    assert torch.all(mdp.duckfu_recorded_last_action(env)[1] == 0)
+    env.episode_length_buf = torch.tensor([1, 2])
+    assert torch.all(mdp.duckfu_recorded_last_action(env) == 0)
+    assert mdp.duckfu_recorded_action_rate(env)[0].item() == pytest.approx(14 * 0.6**2)
+

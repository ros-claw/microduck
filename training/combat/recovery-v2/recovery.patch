diff --git a/src/mjlab_microduck/tasks/mdp.py b/src/mjlab_microduck/tasks/mdp.py
index c813863..921244d 100644
--- a/src/mjlab_microduck/tasks/mdp.py
+++ b/src/mjlab_microduck/tasks/mdp.py
@@ -8364,3 +8364,114 @@ def duckfu_locomotion_commands(env, env_ids):
     head_command=env.command_manager.get_term("head_pose").command
     command[env_ids]=env._duckfu_loco_commands[env_ids,phase]*moving[:,None]
     head_command[env_ids]=env._duckfu_loco_head[env_ids,phase]*moving[:,None]
+
+
+# Recorded-contact recovery specialist. Reset-only writes; ordinary 61D motor.
+def duckfu_recorded_recovery_reset(env, env_ids, states_path: str):
+    import json
+    from pathlib import Path
+
+    if not hasattr(env, "_df_recovery_pool"):
+        path = Path(states_path)
+        meta = json.loads(path.with_suffix(".json").read_text())
+        if meta["split"] != "development":
+            raise ValueError("Recovery training must not load validation trajectories")
+        data = np.load(path)
+        eligible = np.flatnonzero(data["eligible"])
+        if not len(eligible):
+            raise ValueError("No physically supported recorded training states")
+        env._df_recovery_pool = {k:torch.as_tensor(data[k][eligible],device=env.device,dtype=torch.float32)
+                                 for k in ("root","joints","joint_velocity","last_action")}
+        env._df_recovery_source_names = meta["rows"][int(eligible[0])]["joint_names"]
+        env._df_recovery_last = torch.zeros((env.num_envs,14),device=env.device)
+        env._df_recovery_stable_steps = torch.zeros(env.num_envs,device=env.device)
+        env._df_recovery_paid = torch.zeros(env.num_envs,dtype=torch.bool,device=env.device)
+    asset = env.scene["robot"]
+    ids = _servo_joint_ids(env,asset)
+    if [asset.joint_names[i] for i in ids] != env._df_recovery_source_names:
+        raise ValueError("Recorded servo order differs from the actual training robot")
+    pool = env._df_recovery_pool
+    selected = torch.randint(len(pool["root"]),(len(env_ids),),device=env.device)
+    root = pool["root"][selected].clone()
+    root[:,:3] += env.scene.env_origins[env_ids]
+    asset.write_root_state_to_sim(root,env_ids=env_ids)
+    asset.write_joint_state_to_sim(pool["joints"][selected],pool["joint_velocity"][selected],joint_ids=ids,env_ids=env_ids)
+    env._df_recovery_last[env_ids] = pool["last_action"][selected]
+    env._df_recovery_stable_steps[env_ids] = 0
+    env._df_recovery_paid[env_ids] = False
+
+
+def duckfu_recorded_last_action(env):
+    # mjlab resets ActionManager AFTER reset events. Preserve the predecessor
+    # motor output in the first observation, then use the actual current action.
+    action = env.action_manager.action
+    if not hasattr(env,"_df_recovery_last"):
+        return action
+    return torch.where((env.episode_length_buf == 0)[:,None],env._df_recovery_last,action)
+
+
+def duckfu_recorded_action_rate(env):
+    previous = env.action_manager.prev_action
+    if hasattr(env,"_df_recovery_last"):
+        previous = torch.where((env.episode_length_buf <= 1)[:,None],env._df_recovery_last,previous)
+    return torch.sum((env.action_manager.action-previous).square(),dim=1)
+
+
+def _duckfu_recovery_state(env):
+    robot = env.scene["robot"]
+    q = robot.data.root_link_quat_w
+    up = 1-2*(q[:,1].square()+q[:,2].square())
+    height = robot.data.root_link_pos_w[:,2]-env.scene.env_origins[:,2]
+    speed = torch.linalg.vector_norm(robot.data.root_link_lin_vel_w[:,:2],dim=1)
+    sensor = env.scene.sensors["feet_ground_contact"].data
+    history = sensor.force_history
+    if history is None:
+        raise ValueError("Recovery support requires solved substep contact history")
+    # netforce is world-frame. The mean vertical load over all substeps equals
+    # the measured support impulse divided by the 20 ms motor period. No
+    # contact persistence timer, pose-derived support, or synthetic force.
+    load = history[...,2].abs().mean(dim=-1).sum(dim=-1)
+    return up,height,speed,load > 0.5
+
+
+def duckfu_recovery_progress(env):
+    up,height,_,_ = _duckfu_recovery_state(env)
+    potential = up + 6*height.clamp(max=0.115)
+    if not hasattr(env,"_df_recovery_potential"):
+        env._df_recovery_potential = potential.clone()
+    fresh = env.episode_length_buf <= 1
+    env._df_recovery_potential[fresh] = potential[fresh]
+    delta = potential-env._df_recovery_potential
+    env._df_recovery_potential = potential.clone()
+    return delta/env.step_dt
+
+
+def duckfu_recovery_standing(env):
+    up,height,speed,supported = _duckfu_recovery_state(env)
+    good = (up>0.94)&(height>0.105)&(speed<0.16)&supported
+    # No annuity for a stable flop, headstand, or unsupported flight.
+    return good.float()*torch.exp(-((height-0.117)/0.025).square())
+
+
+def duckfu_recovery_completion(env):
+    up,height,speed,supported = _duckfu_recovery_state(env)
+    good = (up>0.94)&(height>0.105)&(speed<0.16)&supported
+    if not hasattr(env,"_df_recovery_stable_steps"):
+        env._df_recovery_stable_steps = torch.zeros(env.num_envs,device=env.device)
+        env._df_recovery_paid = torch.zeros(env.num_envs,dtype=torch.bool,device=env.device)
+    env._df_recovery_stable_steps = torch.where(good,env._df_recovery_stable_steps+1,0)
+    done = (env._df_recovery_stable_steps*env.step_dt >= 0.30-1e-6)&~env._df_recovery_paid
+    env._df_recovery_paid |= done
+    return done.float()/env.step_dt
+
+
+def duckfu_recovery_unfinished(env):
+    return (duckfu_recovery_standing(env)<0.5).float()
+
+
+def duckfu_recovery_home_cost(env):
+    robot = env.scene["robot"]
+    ids = _servo_joint_ids(env,robot)
+    up,height,_,supported = _duckfu_recovery_state(env)
+    error = (robot.data.joint_pos[:,ids]-robot.data.default_joint_pos[:,ids]).square().mean(dim=1)
+    return error*((up>0.94)&(height>0.105)&supported).float()

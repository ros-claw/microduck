@@ -0,0 +1,176 @@
+"""CF05 candidate: motor-only dash into a 737 g free physical target.
+
+Target is a curriculum block, not another robot. Final qualification must use
+CPU duel profile. Position servos and visual-part hull collision masks are
+shared with the delivery implementation; no runtime pushes or root edits.
+"""
+
+from copy import deepcopy
+import mujoco
+from dataclasses import dataclass
+import numpy as np
+from mjlab.terrains.terrain_generator import (
+    SubTerrainCfg,
+    TerrainGeneratorCfg,
+    TerrainOutput,
+    TerrainGeometry,
+)
+from mjlab.entity import EntityCfg
+from mjlab.managers import EventTermCfg, RewardTermCfg, TerminationTermCfg
+from mjlab_microduck.robot.microduck_constants import (
+    MICRODUCK_STANDUP_PD_ROBOT_CFG,
+    get_standup_spec,
+)
+from .microduck_velocity_env_cfg import make_microduck_velocity_env_cfg, MicroduckRlCfg
+from . import mdp
+
+
+def combat_robot_spec():
+    from microduck_lab.combat.world import external_parts
+
+    s = get_standup_spec()
+    external_parts(s, 0)
+    for a in s.actuators:
+        a.forcelimited = True
+        a.forcerange = [-0.6405, 0.6405]
+    for g in s.geoms:
+        if g.contype or g.conaffinity:
+            g.solref = [0.0005, 1.0]
+            g.solimp = [0.99, 0.99, 0.001, 0.5, 2.0]
+            g.margin = 0.0
+    return s
+
+
+def target_spec():
+    s = mujoco.MjSpec()
+    b = s.worldbody.add_body(name="target", pos=[0.28, 0, 0.09])
+    b.add_freejoint()
+    for name, layer, affinity, mass in [
+        ("support", 16, 17, 0.73724318),
+        ("external", 128, 64, 0.0),
+    ]:
+        b.add_geom(
+            name="target_" + name,
+            type=mujoco.mjtGeom.mjGEOM_BOX,
+            size=[0.045, 0.05, 0.09],
+            mass=mass,
+            contype=layer,
+            conaffinity=affinity,
+            friction=[1.0, 0.005, 0.0001],
+            solref=[0.0005, 1.0],
+            solimp=[0.99, 0.99, 0.001, 0.5, 2.0],
+            rgba=[0.7, 0.3, 0.2, 1.0],
+        )
+    return s
+
+
+@dataclass(kw_only=True)
+class DuckFuFloor(SubTerrainCfg):
+    def function(self, difficulty, spec, rng):
+        ox, oy = self.size[0] / 2, self.size[1] / 2
+        g = spec.body("terrain").add_geom(
+            type=mujoco.mjtGeom.mjGEOM_BOX,
+            pos=[ox, oy, -0.04],
+            size=[ox, oy, 0.04],
+            contype=1,
+            conaffinity=20,
+            friction=[1.0, 0.005, 0.0001],
+            solref=[0.0005, 1.0],
+            solimp=[0.99, 0.99, 0.001, 0.5, 2.0],
+        )
+        return TerrainOutput(
+            origin=np.array([ox, oy, 0.0]),
+            geometries=[TerrainGeometry(geom=g, color=(0.4, 0.4, 0.4, 1))],
+        )
+
+
+def make_duckfu_env_cfg(play=False):
+    cfg = make_microduck_velocity_env_cfg(play=play)
+    cfg.scene.entities["robot"] = deepcopy(MICRODUCK_STANDUP_PD_ROBOT_CFG)
+    cfg.scene.entities["robot"].spec_fn = combat_robot_spec
+    cfg.scene.entities["robot"].collisions = ()
+    cfg.scene.entities["robot"].init_state.pos = (0.0, 0.0, 0.12)
+    cfg.scene.entities["target"] = EntityCfg(
+        spec_fn=target_spec, init_state=EntityCfg.InitialStateCfg(pos=(0.28, 0.0, 0.09))
+    )
+    cfg.scene.terrain.terrain_type = "generator"
+    cfg.scene.terrain.terrain_generator = TerrainGeneratorCfg(
+        size=(3.0, 3.0),
+        num_rows=1,
+        num_cols=1,
+        sub_terrains={"floor": DuckFuFloor()},
+        border_width=0.0,
+        color_scheme="none",
+    )
+    cfg.events["reset_base"].params["pose_range"] = {
+        "x": (-0.005, 0.005),
+        "y": (-0.005, 0.005),
+        "z": (0.0, 0.003),
+        "yaw": (-0.025, 0.025),
+    }
+    cfg.events["reset_base"].params["velocity_range"] = {}
+    cfg.sim.nconmax = 256
+    cfg.sim.njmax = 5000
+    cfg.sim.mujoco.timestep = 0.0005
+    cfg.sim.mujoco.iterations = 80
+    cfg.sim.mujoco.integrator = "euler"
+    cfg.decimation = 40
+    cfg.episode_length_s = 2.5
+    # Foot contacts with terrain keep native layers. Base plane layer1 receives
+    # type4/16 via robot/target affinity bit1; visual hulls ignore terrain.
+    cfg.events.pop("randomize_joint_friction", None)
+    cfg.events.pop("randomize_motor_gains", None)
+    cfg.events.pop("push_robot", None)
+    cfg.events.pop("randomize_body_mass", None)
+    for k in list(cfg.events):
+        if cfg.events[k].mode == "interval":
+            cfg.events.pop(k)
+    cfg.events["reset_target"] = EventTermCfg(
+        func=mdp.duckfu_reset_target, mode="reset"
+    )
+    cfg.events["duckfu_commands"] = EventTermCfg(
+        func=mdp.duckfu_commands, mode="interval", interval_range_s=(0.02, 0.02)
+    )
+    cfg.commands["twist"].ranges.lin_vel_x = (0.4, 0.4)
+    cfg.commands["twist"].ranges.lin_vel_y = (0.0, 0.0)
+    cfg.commands["twist"].ranges.ang_vel_z = (0.0, 0.0)
+    cfg.commands["twist"].rel_standing_envs = 0.0
+    for name in ("head_pose", "body_pose"):
+        cfg.commands[name].ranges = tuple((0.0, 0.0) for _ in cfg.commands[name].ranges)
+    for group in ("actor", "critic"):
+        for term in cfg.observations[group].terms.values():
+            term.delay_min_lag = 0
+            term.delay_max_lag = 0
+    # Retain NaN and official fall guards; no rule-based contact termination.
+    for key in list(cfg.curriculum):
+        cfg.curriculum.pop(key)
+    for key in list(cfg.rewards):
+        if key not in (
+            "upright",
+            "action_rate_l2",
+            "joint_pos_limits",
+            "joint_vel_limits",
+            "dof_pos_limits",
+            "dof_vel_limits",
+        ):
+            cfg.rewards.pop(key)
+    cfg.rewards["duckfu_approach"] = RewardTermCfg(func=mdp.duckfu_approach, weight=1.0)
+    cfg.rewards["duckfu_target_frontier"] = RewardTermCfg(
+        func=mdp.duckfu_target_frontier, weight=12.0
+    )
+    cfg.rewards["duckfu_stable"] = RewardTermCfg(func=mdp.duckfu_stable, weight=2.0)
+    cfg.rewards["duckfu_late_motion"] = RewardTermCfg(
+        func=mdp.duckfu_late_motion, weight=-0.2
+    )
+    cfg.rewards["action_rate_l2"].weight = -0.002
+    return cfg
+
+
+DuckFuRlCfg = deepcopy(MicroduckRlCfg)
+DuckFuRlCfg.experiment_name = "duckfu_dash"
+DuckFuRlCfg.run_name = "free_target_pd_candidate"
+DuckFuRlCfg.save_interval = 50
+DuckFuRlCfg.max_iterations = 301
+DuckFuRlCfg.algorithm.symmetry_cfg = None
+DuckFuRlCfg.algorithm.learning_rate = 3e-4
+DuckFuRlCfg.actor.distribution_cfg["init_std"] = 0.2
diff --git a/tests/test_duckfu_cfg.py b/tests/test_duckfu_cfg.py
new file mode 100644
index 0000000..1789a62
--- /dev/null
+++ b/tests/test_duckfu_cfg.py
@@ -0,0 +1,62 @@
+from types import SimpleNamespace
+import torch
+import pytest
+from mjlab_microduck.tasks.microduck_duckfu_env_cfg import (
+    make_duckfu_env_cfg,
+    target_spec,
+    combat_robot_spec,
+)
+from mjlab_microduck.tasks import mdp
+
+
+def test_pd_and_spawn_contract():
+    cfg = make_duckfu_env_cfg()
+    assert cfg.decimation * cfg.sim.mujoco.timestep == pytest.approx(0.02)
+    assert cfg.scene.entities["robot"].init_state.pos[2] == 0.12
+    reset = cfg.events["reset_base"].params["pose_range"]
+    assert reset["z"] == (0.0, 0.003) and abs(reset["yaw"][0]) < 0.03
+    assert all(
+        c.mode != "interval" or name == "duckfu_commands"
+        for name, c in cfg.events.items()
+    )
+    assert cfg.rewards["duckfu_target_frontier"].weight > 0
+    assert cfg.rewards["duckfu_late_motion"].weight < 0
+    m = target_spec().compile()
+    assert sum(m.body_mass) == pytest.approx(0.73724318)
+    r = combat_robot_spec().compile()
+    assert r.nu == 14 and r.nv == 20
+    assert max(r.actuator_forcerange[:, 1]) == pytest.approx(0.6405)
+    assert sum(r.body_mass) == pytest.approx(0.73724318)
+    assert cfg.sim.nconmax >= 256
+
+
+def test_bounded_target_progress_no_hold_reward_and_reset_clears_history():
+    target = SimpleNamespace(
+        data=SimpleNamespace(root_link_pos_w=torch.tensor([[0.28, 0.0, 0.09]]))
+    )
+    robot = SimpleNamespace(
+        data=SimpleNamespace(projected_gravity_b=torch.tensor([[0.0, 0.0, -1.0]]))
+    )
+
+    class Scene(dict):
+        pass
+
+    scene = Scene(robot=robot, target=target)
+    scene.env_origins = torch.zeros((1, 3))
+    env = SimpleNamespace(
+        scene=scene, episode_length_buf=torch.zeros(1, dtype=torch.long), step_dt=0.02
+    )
+    assert mdp.duckfu_target_frontier(env).item() == 0.0
+    env.episode_length_buf[:] = 2
+    target.data.root_link_pos_w[:, 0] += 0.01
+    assert mdp.duckfu_target_frontier(env).item() > 0
+    assert mdp.duckfu_target_frontier(env).item() == 0.0
+    env.episode_length_buf[:] = 0
+    target.data.root_link_pos_w[:, 0] = 0.28
+    assert mdp.duckfu_target_frontier(env).item() == 0.0
+    env.episode_length_buf[:] = 2
+    target.data.root_link_pos_w[:, 0] += 0.005
+    assert mdp.duckfu_target_frontier(env).item() == pytest.approx(0.25, abs=1e-5)
+    robot.data.projected_gravity_b[:, 2] = 0.2
+    target.data.root_link_pos_w[:, 0] += 0.01
+    assert mdp.duckfu_target_frontier(env).item() == 0.0

diff --git a/src/mjlab_microduck/tasks/mdp.py b/src/mjlab_microduck/tasks/mdp.py
index 960c014..2c94e1b 100644
--- a/src/mjlab_microduck/tasks/mdp.py
+++ b/src/mjlab_microduck/tasks/mdp.py
@@ -8176,3 +8176,65 @@ def sweep_height_tracking(env):
     target = sweep_body_command(env)[:, 2]
     good = ropehop_clean_posture(env) & ~_sensor_any_contact(env, "sweep_contact")
     return torch.exp(-((height-target)/.025).square()) * good.float()
+
+
+# ── Duck Fu free-target curriculum (CF05 candidate, simulation only) ──────────
+def duckfu_reset_target(env, env_ids):
+    """Only the episode reset boundary writes target pose/velocity."""
+    target = env.scene["target"]
+    n = len(env_ids)
+    pose = target.data.default_root_state[env_ids, :7].clone()
+    pose[:, :3] += env.scene.env_origins[env_ids]
+    pose[:, 0] += torch.empty(n, device=env.device).uniform_(-0.035, 0.035)
+    pose[:, 1] += torch.empty(n, device=env.device).uniform_(-0.015, 0.015)
+    target.write_root_link_pose_to_sim(pose, env_ids=env_ids)
+    target.write_root_link_velocity_to_sim(
+        torch.zeros((n, 6), device=env.device), env_ids=env_ids
+    )
+
+
+def duckfu_commands(env, env_ids):
+    """Physical velocity command: short drive then zero target for braking."""
+    term = env.command_manager.get_term("twist")
+    command = term.command
+    command[env_ids] = 0.0
+    t = env.episode_length_buf[env_ids] * env.step_dt
+    command[env_ids, 0] = torch.where(t < 1.2, 0.4, 0.0)
+
+
+def duckfu_approach(env):
+    robot, target = env.scene["robot"], env.scene["target"]
+    gap = torch.linalg.norm(
+        target.data.root_link_pos_w[:, :2] - robot.data.root_link_pos_w[:, :2], dim=-1
+    )
+    up = (-robot.data.projected_gravity_b[:, 2]).clamp(0.0, 1.0)
+    return torch.exp(-gap.square() / 0.08) * up
+
+
+def duckfu_target_frontier(env):
+    """Bounded forward progress, never a per-step contact-count jackpot."""
+    target = env.scene["target"]
+    x = target.data.root_link_pos_w[:, 0] - env.scene.env_origins[:, 0]
+    if not hasattr(env, "_duckfu_target_origin"):
+        env._duckfu_target_origin = x.clone()
+        env._duckfu_frontier = torch.zeros_like(x)
+    fresh = env.episode_length_buf <= 1
+    env._duckfu_target_origin[fresh] = x[fresh]
+    env._duckfu_frontier[fresh] = 0.0
+    progress = (x - env._duckfu_target_origin).clamp(0.0, 0.12)
+    delta = (progress - env._duckfu_frontier).clamp(0.0, 0.5 * env.step_dt)
+    env._duckfu_frontier = torch.maximum(env._duckfu_frontier, progress)
+    up = (-env.scene["robot"].data.projected_gravity_b[:, 2]).clamp(0.0, 1.0)
+    return delta / env.step_dt * (up > 0.85)
+
+
+def duckfu_stable(env):
+    robot = env.scene["robot"]
+    up = (-robot.data.projected_gravity_b[:, 2]).clamp(0.0, 1.0)
+    z = robot.data.root_link_pos_w[:, 2] - env.scene.env_origins[:, 2]
+    return torch.exp(-((z - 0.12) / 0.03).square()) * up.square()
+
+
+def duckfu_late_motion(env):
+    speed = env.scene["robot"].data.root_link_lin_vel_w[:, :2].square().sum(-1)
+    return speed * (env.episode_length_buf * env.step_dt > 1.5)
diff --git a/src/mjlab_microduck/tasks/microduck_duckfu_env_cfg.py b/src/mjlab_microduck/tasks/microduck_duckfu_env_cfg.py

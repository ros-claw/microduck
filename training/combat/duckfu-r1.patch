@@ -0,0 +1,58 @@
+"""Compare official normalized export with the matching actor checkpoint."""
+
+import argparse
+import json
+import numpy as np
+import onnxruntime as ort
+import torch
+from torch import nn
+
+p = argparse.ArgumentParser()
+p.add_argument("--checkpoint", required=True)
+p.add_argument("--onnx", required=True)
+p.add_argument("--out", required=True)
+a = p.parse_args()
+c = torch.load(a.checkpoint, map_location="cpu", weights_only=False)["actor_state_dict"]
+net = nn.Sequential(
+    nn.Linear(61, 512),
+    nn.ELU(),
+    nn.Linear(512, 256),
+    nn.ELU(),
+    nn.Linear(256, 128),
+    nn.ELU(),
+    nn.Linear(128, 14),
+)
+net.load_state_dict(
+    {k.removeprefix("mlp."): v for k, v in c.items() if k.startswith("mlp.")}
+)
+obs = np.random.default_rng(1030).normal(size=(128, 61)).astype(np.float32)
+with torch.no_grad():
+    expected = net(
+        (torch.from_numpy(obs) - c["obs_normalizer._mean"])
+        / (c["obs_normalizer._std"] + 0.01)
+    ).numpy()
+o = ort.SessionOptions()
+o.intra_op_num_threads = 1
+o.inter_op_num_threads = 1
+session = ort.InferenceSession(
+    a.onnx, sess_options=o, providers=["CPUExecutionProvider"]
+)
+actual = np.concatenate(
+    [session.run(None, {session.get_inputs()[0].name: x[None]})[0] for x in obs]
+)
+np.testing.assert_allclose(actual, expected, rtol=2e-4, atol=2e-4)
+from pathlib import Path
+
+Path(a.out).write_text(
+    json.dumps(
+        dict(
+            passed=True,
+            samples=len(obs),
+            max_abs_error=float(np.abs(actual - expected).max()),
+            normalization_baked=True,
+        ),
+        indent=2,
+    )
+    + "\n"
+)
+print("Normalized export parity passed", float(np.abs(actual - expected).max()))

+# Continuous commanded joy gait: phase is represented by actual head/body pose
+# commands, in the existing 61-D contract, not a hidden observation channel.
+def joy_phase(env, frequency=1.15):
+    return 2 * math.pi * frequency * env.episode_length_buf * env.step_dt
+
+
+def joy_head_command(env):
+    p = joy_phase(env)
+    e = torch.clamp(env.episode_length_buf * env.step_dt / .8, 0., 1.)
+    return torch.stack((.07*torch.sin(2*p), .03*torch.sin(2*p), .24*torch.sin(p), .12*torch.sin(p)),dim=-1)*e[:,None]
+
+
+def joy_body_command(env):
+    p=joy_phase(env);e=torch.clamp(env.episode_length_buf*env.step_dt/.8,0.,1.);z=torch.zeros_like(p)
+    return torch.stack((z,z,.006*(1-torch.cos(2*p)),.07*torch.sin(p),z,z),dim=-1)*e[:,None]
+
+
+def joy_twist_command(env):
+    asset=env.scene['robot'];pos=asset.data.root_link_pos_w-env.scene.terrain.env_origins
+    quat=asset.data.root_link_quat_w;w,x,y,z=quat.unbind(-1)
+    yaw=torch.atan2(2*(w*z+x*y),1-2*(y*y+z*z))
+    dx=torch.clamp(-2*pos[:,0],-.15,.15);dy=torch.clamp(-2*pos[:,1],-.15,.15)
+    return torch.stack((torch.cos(yaw)*dx+torch.sin(yaw)*dy,-torch.sin(yaw)*dx+torch.cos(yaw)*dy,torch.clamp(-2*yaw,-.8,.8)),dim=-1)
+
+
+def joy_foot_rhythm(env, asset_cfg=SceneEntityCfg('robot',site_names=['left_foot','right_foot'])):
+    asset=env.scene[asset_cfg.name];p=joy_phase(env);e=torch.clamp(env.episode_length_buf*env.step_dt/.8,0.,1.)
+    target=.0005+.024*torch.stack((torch.relu(torch.sin(p))**2,torch.relu(-torch.sin(p))**2),dim=-1)*e[:,None]
+    actual=asset.data.site_pos_w[:,asset_cfg.site_ids,2]-env.scene.terrain.env_origins[:,None,2]
+    return torch.exp(-((actual-target)/.009)**2).prod(-1)
+
+
+def joy_head_tracking(env):
+    a=env.scene['robot'];delta=_servo_joint_pos(env,a)-_servo_default_joint_pos(env,a)
+    return torch.exp(-((delta[:,5:9]-joy_head_command(env))/.20)**2).mean(-1)
+
+
+def joy_balance(env):
+    a=env.scene['robot'];pos=a.data.root_link_pos_w-env.scene.terrain.env_origins;q=a.data.root_link_quat_w;w,x,y,z=q.unbind(-1)
+    roll=torch.atan2(2*(w*x+y*z),1-2*(x*x+y*y));pitch=torch.asin(torch.clamp(2*(w*y-z*x),-1.,1.));yaw=torch.atan2(2*(w*z+x*y),1-2*(y*y+z*z));cmd=joy_body_command(env)
+    error=((pos[:,2]-(.117+cmd[:,2]))/.025)**2+((roll-cmd[:,3])/.18)**2+(pitch/.18)**2+(yaw/.35)**2
+    return torch.exp(-error)
+
+
+def joy_drift_cost(env):
+    a=env.scene['robot'];pos=a.data.root_link_pos_w-env.scene.terrain.env_origins
+    return -(pos[:,:2].square().sum(-1)+.05*a.data.root_link_lin_vel_w[:,:2].square().sum(-1))
+
+
+# Matched training/deployment target conditioner, only for JoySmoothPD.
+# Raw previous actions remain in the standard 61-D observation contract.
+from dataclasses import dataclass as _joy_dataclass
+from mjlab.envs.mdp.actions.actions import JointPositionActionCfg as _JoyPositionCfg,JointPositionAction as _JoyPositionAction
+
+
+class JoySmoothPositionAction(_JoyPositionAction):
+    def __init__(self,cfg,env):
+        super().__init__(cfg,env)
+        self._joy_target=torch.zeros_like(self._processed_actions)
+        self._joy_pending=torch.ones(env.num_envs,dtype=torch.bool,device=env.device)
+
+    def process_actions(self,actions):
+        super().process_actions(actions)
+        initial=self._entity.data.data.ctrl[:,self._entity.indexing.ctrl_ids]+self._entity.data.encoder_bias[:,self._target_ids]
+        previous=torch.where(self._joy_pending[:,None],initial,self._joy_target)
+        delta=torch.clamp(self.cfg.joy_alpha*(self._processed_actions-previous),-self.cfg.joy_max_step,self.cfg.joy_max_step)
+        self._joy_target.copy_(previous+delta)
+        self._processed_actions=self._joy_target
+        self._joy_pending.fill_(False)
+
+    def reset(self,env_ids=None):
+        super().reset(env_ids)
+        self._joy_pending[env_ids]=True
+
+
+@_joy_dataclass(kw_only=True)
+class JoySmoothPositionActionCfg(_JoyPositionCfg):
+    joy_alpha:float=.25
+    joy_max_step:float=.08
+    def build(self,env):
+        return JoySmoothPositionAction(self,env)
+
+
+def initialize_joy_servo_targets(env,env_ids):
+    a=env.scene['robot'];ids,_=a.find_joints_by_actuator_names((r"^(?!passive_).*",))
+    a.data.write_ctrl(a.data.joint_pos[env_ids][:,ids],env_ids=env_ids)

+"""Continuous 1.15 Hz commanded stepping/sway; existing 61-D BAM template."""
+from copy import deepcopy
+from mjlab.managers import ObservationTermCfg,RewardTermCfg,CurriculumTermCfg
+from mjlab.managers.scene_entity_config import SceneEntityCfg
+from mjlab_microduck.robot.microduck_constants import MICRODUCK_STANDUP_ROBOT_CFG,MICRODUCK_STANDUP_PD_ROBOT_CFG
+from .microduck_velocity_env_cfg import make_microduck_velocity_env_cfg,MicroduckRlCfg
+from . import mdp
+
+
+def make_microduck_joy_env_cfg(play=False,pd_actuators=False):
+    cfg=make_microduck_velocity_env_cfg(play=play)
+    cfg.scene.entities['robot']=deepcopy(MICRODUCK_STANDUP_PD_ROBOT_CFG if pd_actuators else MICRODUCK_STANDUP_ROBOT_CFG)
+    if pd_actuators:
+        cfg.scene.entities['robot'].spec_fn=joy_pd_spec
+        cfg.scene.entities['robot'].collisions=()
+        cfg.scene.spec_fn=joy_pd_terrain_spec
+        cfg.events.pop('randomize_joint_friction',None)
+        cfg.sim.mujoco.timestep=.001
+        cfg.decimation=20
+    cfg.episode_length_s=8.
+    cfg.sim.mujoco.timestep=.002
+    cfg.decimation=10
+    cfg.sim.mujoco.iterations=30
+    cfg.sim.nconmax=200
+    cfg.events.pop('push_robot',None)
+    cfg.events['reset_base'].params['pose_range']={'x':(-.01,.01),'y':(-.01,.01),'z':(.12,.125),'roll':(-.02,.02),'pitch':(-.02,.02),'yaw':(-.02,.02)}
+    cfg.events['reset_base'].params['velocity_range']={'x':(-.03,.03),'y':(-.03,.03),'z':(-.02,.02)}
+    cfg.commands['twist'].ranges.lin_vel_x=(0.,0.)
+    cfg.commands['twist'].ranges.lin_vel_y=(0.,0.)
+    cfg.commands['twist'].ranges.ang_vel_z=(0.,0.)
+    for group in ('actor','critic'):
+        cfg.observations[group].terms['command']=ObservationTermCfg(func=mdp.joy_twist_command)
+        cfg.observations[group].terms['head_command']=ObservationTermCfg(func=mdp.joy_head_command)
+        cfg.observations[group].terms['body_command']=ObservationTermCfg(func=mdp.joy_body_command)
+    # Preserve DR/encoder/IMU terms and BAM startup expansion from the template.
+    for name in ['track_linear_velocity','track_angular_velocity','air_time','foot_clearance','foot_swing_height','head_pose_tracking','head_pose_bias','body_pose_tracking']:
+        cfg.rewards.pop(name,None)
+    cfg.rewards['pose'].weight=.15
+    cfg.rewards['joy_feet']=RewardTermCfg(func=mdp.joy_foot_rhythm,weight=12.,params={"asset_cfg":SceneEntityCfg("robot",site_names=["left_foot","right_foot"])})
+    cfg.rewards['joy_head']=RewardTermCfg(func=mdp.joy_head_tracking,weight=3.)
+    cfg.rewards['joy_balance']=RewardTermCfg(func=mdp.joy_balance,weight=5.)
+    cfg.rewards['joy_drift']=RewardTermCfg(func=mdp.joy_drift_cost,weight=100.)
+    cfg.rewards['action_rate_l2'].weight=-.05
+    cfg.curriculum={k:v for k,v in cfg.curriculum.items() if k in ('com_range','head_com_range')}
+    cfg.curriculum['action_rate_weight']=CurriculumTermCfg(func=mdp.reward_weight,params={'reward_name':'action_rate_l2','weight_stages':[{'step':0,'weight':-.05},{'step':150*24,'weight':-.15},{'step':300*24,'weight':-.3}]})
+    if pd_actuators:
+        cfg.sim.mujoco.timestep=.001
+        cfg.decimation=20
+        cfg.rewards["action_rate_l2"].weight=-.1
+        cfg.curriculum["action_rate_weight"].params["weight_stages"]=[{"step":0,"weight":-.1},{"step":100*24,"weight":-.5},{"step":200*24,"weight":-1.}]
+    return cfg
+
+MicroduckJoyRlCfg=deepcopy(MicroduckRlCfg)
+MicroduckJoyRlCfg.experiment_name='microduck_joy'
+MicroduckJoyRlCfg.run_name='continuous_joy_v1'
+MicroduckJoyRlCfg.max_iterations=600
+MicroduckJoyRlCfg.save_interval=100
+MicroduckJoyRlCfg.logger='tensorboard'
+MicroduckJoyRlCfg.algorithm.learning_rate=.0003
+MicroduckJoyRlCfg.actor.distribution_cfg['init_std']=.4
+
+
+def joy_pd_spec():
+    # Explicit supported PD family: deployment uses position servos, so use
+    # the same actuator family/current limit rather than transferring BAM targets.
+    from mjlab_microduck.robot.microduck_constants import get_standup_spec
+    spec=get_standup_spec()
+    for a in spec.actuators:
+        a.forcelimited=True;a.forcerange=[-.6405,.6405]
+    for g in spec.geoms:
+        if g.contype & 1:
+            g.solref=[.0012,1.];g.solimp=[.99,.999,.0005,.5,2.];g.margin=0.  # Warp MULTICCD requires zero margin; CPU rehearsal retains .2 mm margin.
+    return spec
+
+def make_microduck_joy_pd_env_cfg(play=False):
+    return make_microduck_joy_env_cfg(play,pd_actuators=True)
+
+MicroduckJoyPdRlCfg=deepcopy(MicroduckJoyRlCfg)
+MicroduckJoyPdRlCfg.experiment_name='microduck_joy_pd'
+MicroduckJoyPdRlCfg.run_name='continuous_pd_v1'
+MicroduckJoyPdRlCfg.max_iterations=400
+
+
+def joy_pd_terrain_spec(spec):
+    for g in spec.body('terrain').geoms:
+        g.solref=[.002,1.];g.solimp=[.9,.95,.001,.5,2.];g.priority=1
+
+
+def make_microduck_joy_smooth_pd_env_cfg(play=False):
+    cfg=make_microduck_joy_pd_env_cfg(play)
+    old=cfg.actions['joint_pos']
+    from dataclasses import fields
+    cfg.actions['joint_pos']=mdp.JoySmoothPositionActionCfg(**{f.name:getattr(old,f.name) for f in fields(old)})
+    from mjlab.managers import EventTermCfg
+    cfg.events['initialize_joy_servo_targets']=EventTermCfg(func=mdp.initialize_joy_servo_targets,mode='reset')
+    return cfg
+
+MicroduckJoySmoothPdRlCfg=deepcopy(MicroduckJoyPdRlCfg)
+MicroduckJoySmoothPdRlCfg.experiment_name='microduck_joy_smooth_pd'
+MicroduckJoySmoothPdRlCfg.run_name='continuous_smooth_pd_v1'
+MicroduckJoySmoothPdRlCfg.max_iterations=200
+MicroduckJoySmoothPdRlCfg.algorithm.learning_rate=.0002

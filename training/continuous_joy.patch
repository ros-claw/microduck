+import torch
+from types import SimpleNamespace
+from mjlab_microduck.tasks.microduck_joy_env_cfg import make_microduck_joy_env_cfg
+from mjlab_microduck.tasks import mdp
+
+
+def test_deployment_contract_and_bam_startup():
+ c=make_microduck_joy_env_cfg()
+ assert c.decimation*c.sim.mujoco.timestep==.02
+ assert list(c.observations['actor'].terms)==['base_ang_vel','projected_gravity','joint_pos','joint_vel','actions','command','head_command','body_command']
+ assert 'expand_bam_friction_fields' in c.events
+ assert c.rewards['joy_drift'].weight>0
+ assert c.rewards['action_rate_l2'].weight<0
+ assert c.rewards['joy_feet'].params['asset_cfg'].site_names==['left_foot','right_foot']
+ assert 'push_robot' not in c.events
+
+
+def test_pose_commands_are_continuous_bounded_and_keep_slots():
+ e=SimpleNamespace(episode_length_buf=torch.arange(500),step_dt=.02)
+ h,b=mdp.joy_head_command(e),mdp.joy_body_command(e)
+ assert h.shape==(500,4) and b.shape==(500,6)
+ assert (h[0]==0).all() and (b[0]==0).all()
+ assert (h[1:]-h[:-1]).abs().max()<.04
+ assert (b[1:]-b[:-1]).abs().max()<.02
+ assert h.abs().max()<=.24 and b.abs().max()<=.07
+ assert (b[:,0:2]==0).all() and (b[:,4:]==0).all()
+
+
+def test_pd_transfer_uses_matching_servo_limits_and_50_hz():
+ from mjlab_microduck.tasks.microduck_joy_env_cfg import make_microduck_joy_pd_env_cfg,joy_pd_spec
+ c=make_microduck_joy_pd_env_cfg()
+ assert c.decimation*c.sim.mujoco.timestep==.02
+ assert c.sim.mujoco.timestep==.001
+ assert c.scene.entities['robot'].collisions==()
+ assert 'randomize_joint_friction' not in c.events
+ s=joy_pd_spec();m=s.compile()
+ assert m.nu==14
+ assert (abs(m.actuator_forcerange[:,0]+.6405)<1e-8).all()
+ assert (abs(m.actuator_forcerange[:,1]-.6405)<1e-8).all()
+ assert (m.geom_margin==0).all()
+ assert c.rewards['action_rate_l2'].weight==-.1
+
+
+def test_smooth_pd_keeps_raw_observation_actions_and_bounds_targets():
+ from mjlab_microduck.tasks.microduck_joy_env_cfg import make_microduck_joy_smooth_pd_env_cfg
+ c=make_microduck_joy_smooth_pd_env_cfg()
+ assert c.actions['joint_pos'].joy_alpha==.25
+ assert c.actions['joint_pos'].joy_max_step==.08
+ assert c.events['initialize_joy_servo_targets'].mode=='reset'
+ action=object.__new__(mdp.JoySmoothPositionAction)
+ action.cfg=SimpleNamespace(clip=None,joy_alpha=.25,joy_max_step=.08)
+ action._raw_actions=torch.zeros(2,14);action._processed_actions=action._raw_actions.clone()
+ action._scale=1.;action._offset=torch.zeros(2,14);action._target_ids=torch.arange(14)
+ initial=torch.linspace(-.2,.2,14).repeat(2,1)
+ action._entity=SimpleNamespace(data=SimpleNamespace(data=SimpleNamespace(ctrl=initial.clone()),encoder_bias=torch.zeros(2,14)),indexing=SimpleNamespace(ctrl_ids=torch.arange(14)))
+ action._joy_target=torch.zeros(2,14);action._joy_pending=torch.ones(2,dtype=torch.bool)
+ previous=initial.clone()
+ for raw in [torch.ones(2,14),-torch.ones(2,14),torch.full((2,14),.3)]:
+  expected=previous+torch.clamp(.25*(raw-previous),-.08,.08)
+  action.process_actions(raw)
+  torch.testing.assert_close(action._processed_actions,expected)
+  torch.testing.assert_close(action._raw_actions,raw)
+  assert (action._processed_actions-previous).abs().max()<=.080001
+  previous=expected
